<Project Sdk="Microsoft.NET.Sdk">

  <!-- AetheriaInstaller : installe le Launcher (et les modules qui l'accompagnent), crée un
       raccourci sur le bureau. Un vrai installateur Windows, écrit en C# comme le reste du
       projet plutôt qu'avec un outil externe (Inno Setup, WiX) — voir Docs/README.md pour la
       justification de ce choix. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Aetheria.Installer</RootNamespace>
    <AssemblyName>AetheriaInstaller</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Aetheria.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Voir GDD/demande utilisateur — "un seul exécutable pour télécharger le Launcher avec le
       jeu" : Payload.zip (Launcher + Client publiés, voir Sites/README.md) embarqué comme
       ressource quand présent, pour publier l'installateur en un seul fichier autonome
       (PublishSingleFile) plutôt qu'un zip contenant l'exécutable + un dossier Payload/ à côté.
       Condition="Exists(...)" : le projet continue de se construire normalement en développement,
       avant que ce fichier n'ait été produit. -->
  <ItemGroup Condition="Exists('Resources\Payload.zip')">
    <EmbeddedResource Include="Resources\Payload.zip" LogicalName="Aetheria.Installer.Resources.Payload.zip" />
  </ItemGroup>

</Project>

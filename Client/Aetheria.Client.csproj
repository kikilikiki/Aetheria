<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aetheria.Client : jeu joueur (rendu, interface, combats, exploration) basé sur Aetheria.Engine. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aetheria.Client</RootNamespace>
    <AssemblyName>Aetheria.Client</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Aetheria.Engine.csproj" />
    <ProjectReference Include="..\Shared\Aetheria.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Musique (voir GDD/demande utilisateur — "ajoute les musiques (/music)") : fichiers sources
       dans /Music à la racine du dépôt (non commités, voir .gitignore), copiés à côté de
       l'exécutable dans Music/ pour que MusicService les retrouve au runtime. -->
  <ItemGroup>
    <Content Include="..\Music\*.wav">
      <Link>Music\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

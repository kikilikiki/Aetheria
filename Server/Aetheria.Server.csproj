<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aetheria.Server : serveur MMORPG (monde persistant, connexions joueurs, synchronisation). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aetheria.Server</RootNamespace>
    <AssemblyName>Aetheria.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Aetheria.Shared.csproj" />
    <ProjectReference Include="..\Database\Aetheria.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permet d'héberger Kestrel/Minimal API (compte joueur) sans passer au SDK Web. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

# Sorties de compilation (redirigées vers build/ par Directory.Build.props)
build/
bin/
obj/

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.user
*.suo

# Résultats de tests / crash dumps
TestResults/
*.log
*.dmp

# Fichiers de publication
publish/
*.pubxml.user

# Installateurs : publiés en GitHub Releases (voir Sites/README.md), pas commités dans le
# dépôt — ni les artefacts finaux, ni les fichiers extraits/loose qui servent à les reconstruire.
Sites/downloads/AetheriaSetup.exe
Sites/downloads/Payload/
Sites/downloads/AetheriaInstaller.*
Sites/downloads/Aetheria.Shared.dll
Sites/downloads/Aetheria.Shared.pdb
Sites/downloads/CommunityToolkit.Mvvm.dll

# Voir Sites/README.md — section "Paquet Linux" : binaires regenerables via
# `dotnet publish -r linux-x64`, pas commites (scaffolding/scripts commites, pas les artefacts).
Sites/downloads/linux/aetheria-client-deb/opt/aetheria/Aetheria.Client
Sites/downloads/linux/aetheria-client-deb/opt/aetheria/libglfw.so.3
Sites/downloads/linux/Aetheria.AppDir/usr/bin/Aetheria.Client
Sites/downloads/linux/Aetheria.AppDir/usr/bin/libglfw.so.3
Sites/downloads/linux/*.deb
Sites/downloads/linux/*.AppImage
Sites/downloads/linux/*.tar.gz

# La règle globale "bin/" ci-dessus attrape aussi le usr/bin/ du paquet Linux (FHS) : on garde
# le petit script wrapper (le vrai binaire reste ignoré via les règles explicites ci-dessus).
!Sites/downloads/linux/aetheria-client-deb/usr/bin/
!Sites/downloads/linux/aetheria-client-deb/usr/bin/aetheria


<Window x:Class="Aetheria.Launcher.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aetheria.Launcher"
        xmlns:behaviors="clr-namespace:Aetheria.Launcher.Behaviors"
        xmlns:loc="clr-namespace:Aetheria.Launcher.Localization"
        Title="{Binding Title}"
        Height="700" Width="1080"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0C"
        FontFamily="Segoe UI,Ubuntu,Cantarell,Noto Sans,sans-serif">

    <!--
        Repasse visuelle (voir demande utilisateur — "sa fait beaucoup trop ia, je ne veux pas que
        sa soit les meme couleur et style graphique que les ia utilisé") : la précédente palette
        bleu marine + doré, les coins très arrondis partout et les lueurs floutées en fond sont un
        motif très reconnaissable des interfaces générées par IA — remplacés ici par une identité
        "acier + rouge sombre" (voir choix utilisateur), des coins nettement moins arrondis
        (silhouette plus anguleuse, moins "carte web"), plus aucune lueur floutée décorative, et
        une ombre portée DURE (décalage net, sans flou) sur le bouton principal plutôt que le halo
        flouté générique d'avant. Structure et bindings inchangés — voir MainViewModel.cs. La
        Boutique reste un Border (jamais un Button, jamais de Command) : visible mais impossible à
        atteindre, badge cadenas à l'appui.

        Porté de WPF vers Avalonia (voir Sites/README.md, section "Paquet Linux") pour un vrai
        Launcher installable sur Linux, pas seulement le Client. Visibility (WPF) -> IsVisible
        (bool direct, Avalonia n'a pas de Visibility.Collapsed) ; Trigger/Storyboard (WPF) ->
        pseudo-classes (:pointerover/:pressed/:focus/:disabled) + Transitions/Style.Animations
        (Avalonia) ; PasswordBox (WPF) -> TextBox + PasswordChar (Avalonia, directement bindable) ;
        ListView -> ListBox ; icônes Segoe MDL2 Assets (police Windows) -> symboles Unicode
        multiplateformes.
    -->
    <Window.Resources>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:UsernameToAvatarColorConverter x:Key="AvatarColorConverter" />
        <local:UsernameToInitialConverter x:Key="AvatarInitialConverter" />
        <local:AvatarUrlToBitmapConverter x:Key="AvatarBitmapConverter" />
        <local:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBool" />
        <local:OnlineStatusToColorConverter x:Key="OnlineStatusColorConverter" />
        <local:BoolToPasswordCharConverter x:Key="PasswordCharConverter" />

        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#37383D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A8353A" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#6E1F23" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#C4474B" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8B8C91" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E0483F" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#6FA37A" />
        <SolidColorBrush x:Key="FieldBrush" Color="#1D1E22" />
        <SolidColorBrush x:Key="FieldHoverBrush" Color="#26272C" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#08090A" />
        <SolidColorBrush x:Key="AccentGradientBrush" Color="#A8353A" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0A0C" />

        <DataTemplate x:Key="NewsCardTemplate">
            <Button Classes="newsCard"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenNewsDetailCommand}"
                    CommandParameter="{Binding}">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#E7E5E3" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ShortDescription}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                    <TextBlock Text="{Binding PublishedLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Champs de saisie : coins presque droits, halo rouge sombre au focus/survol. S'appuie
             sur le template par défaut du thème Fluent (déjà TemplateBinding Background/
             BorderBrush/CornerRadius/Padding) plutôt que de le réimplémenter. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="#E7E5E3" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{StaticResource FieldHoverBrush}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="{StaticResource FieldHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#292325" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="#3A2427" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{StaticResource FieldBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <!-- Bouton standard (secondaire) : échelle + couleur animées au survol/pression, via
             Transitions (Avalonia) plutôt que Storyboard (WPF) — s'appuie sur le template Button
             par défaut du thème Fluent (Border+ContentPresenter avec CornerRadius/Background/
             BorderBrush templatés). -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#1E1F24" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#2A2B31" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.035)" />
        </Style>
        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="#151519" />
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.secondary:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Bouton "lien" sans fond (fiche créateur, liens sociaux) : glissement + couleur
             accent animés au survol. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9C6C2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="RenderTransform" Value="translate(0px,0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="RenderTransform" Value="translate(4px,0px)" />
        </Style>

        <!-- Gros bouton d'action principal ("JOUER"/"MISE À JOUR") : plaque rouge sombre avec
             ombre DURE décalée (pas de flou — voir demande utilisateur, éviter le halo flouté
             générique), surbrillance plate au survol plutôt qu'un glow. Template dédié
             (Grid à 3 couches) : le template Button par défaut ne suffit pas ici. -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="#F3E9E9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="3" Background="#050506" Margin="4,5,-4,-5" />
                        <Border Name="Bg" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="#A8353A"
                                BorderBrush="#6E1F23" BorderThickness="1.5">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Name="HoverOverlay" CornerRadius="3" Background="#C4474B" Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ Border#HoverOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Icône décorative de la barre latérale (cosmétique — pas de navigation multi-page dans
             cette version, voir Docs/README.md). -->
        <Style Selector="Border.sidebarIcon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Même look que sidebarIcon, mais cliquable — surbrillance + échelle animées au survol. -->
        <Style Selector="Button.sidebarIcon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sidebarIcon:pointerover">
            <Setter Property="Background" Value="#1D1E22" />
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>

        <!-- Carte actualité cliquable : bande d'accent + léger soulèvement animés au survol.
             Template dédié pour la bande d'accent (partie nommée AccentBar). -->
        <Style Selector="Button.newsCard">
            <Setter Property="Background" Value="#1A1B1F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#37383D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransform" Value="translate(0px,0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="14">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.14" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Name="AccentBar" Grid.Column="0" Width="3" Margin="0,0,12,0"
                                    Background="{StaticResource AccentGradientBrush}" Opacity="0.55">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.newsCard:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-2px)" />
        </Style>
        <Style Selector="Button.newsCard:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="#212226" />
        </Style>
        <Style Selector="Button.newsCard:pointerover /template/ Border#AccentBar">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- En-tête réutilisé par tous les panneaux superposés : coins presque droits, pas
             d'ombre portée floutée (voir demande utilisateur). -->
        <Style Selector="Border.overlayCard">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- Pastille de statut serveur (voir StatusPulseStoryboard côté WPF) : pulsation infinie
             tant que la classe "pulse" est active (voir Classes.pulse="{Binding IsServerOnline}"
             plus bas) — équivalent Avalonia idiomatique du DataTrigger.EnterActions/ExitActions
             + BeginStoryboard/StopStoryboard nommé de la version WPF. -->
        <Style Selector="Ellipse.pulse">
            <!-- RenderTransform est de type ITransform (interface) côté propriété Avalonia : pas
                 d'animateur enregistré pour ce type, même si la valeur "scale(x)" se convertit
                 correctement en usage statique (crash "No animator registered for the property
                 RenderTransform" au démarrage sinon, voir retour utilisateur - "erreur sur le
                 launcher" après la 0.3.1). Il faut fixer un ScaleTransform concret puis animer
                 ses sous-propriétés ScaleX/ScaleY (double, animées nativement) via la syntaxe
                 "(ScaleTransform.ScaleX)" - pattern documenté par Avalonia lui-même. -->
            <Setter Property="RenderTransform">
                <ScaleTransform />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="(ScaleTransform.ScaleX)" Value="1" />
                        <Setter Property="(ScaleTransform.ScaleY)" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(ScaleTransform.ScaleX)" Value="1.5" />
                        <Setter Property="(ScaleTransform.ScaleY)" Value="1.5" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale : logo + icônes, liseré acier vertical à droite. -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <!-- Emblème (pas une icône pleine couleur générique) : plaque sombre, liseré
                         rouge, lettre en accent — voir demande utilisateur, éviter le rond/carré
                         plein dégradé typique des logos générés par IA. -->
                    <Border Width="44" Height="44" CornerRadius="3" Margin="0,0,0,30" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="21" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border Classes="sidebarIcon" ToolTip.Tip="{loc:Tr 'Accueil'}">
                        <TextBlock Text="⌂" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" />
                    </Border>
                    <!-- Réservé aux comptes admin/fondateur (voir GDD/demande utilisateur — panneau
                         d'administration accessible depuis le Launcher, "seulement pour les admin/
                         fonda") : masqué pour tout le monde d'autre. -->
                    <Button Classes="sidebarIcon" ToolTip.Tip="{loc:Tr 'Communauté (administration)'}"
                            Command="{Binding ToggleAdminPanelCommand}"
                            IsVisible="{Binding IsAdminAccount}">
                        <TextBlock Text="☰" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" />
                    </Button>
                    <!-- Voir GDD/demande utilisateur — "les admin peut voir les report sur une page
                         sur le launcher" : réservé aux comptes admin/fondateur, même logique que le
                         bouton Communauté ci-dessus. -->
                    <Button Classes="sidebarIcon" ToolTip.Tip="{loc:Tr 'Signalements de joueurs'}"
                            Command="{Binding ToggleReportsPanelCommand}"
                            IsVisible="{Binding IsAdminAccount}">
                        <TextBlock Text="⚑" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                    </Button>
                    <!-- Voir GDD/demande utilisateur — "un bouton pour le leaderboard en jeu et sur le launcher". -->
                    <Button Classes="sidebarIcon" ToolTip.Tip="{loc:Tr 'Classement'}" Command="{Binding ToggleLeaderboardCommand}">
                        <TextBlock Text="★" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                    </Button>
                    <!-- Voir demande utilisateur — "garde la partie shop mais laisse la impossible à
                         accéder" : reste un Border décoratif (jamais un Button, aucune Command) —
                         badge cadenas ajouté pour rendre ce verrouillage explicite visuellement. -->
                    <Border Classes="sidebarIcon" ToolTip.Tip="{loc:Tr 'Boutique (bientôt disponible ici)'}">
                        <Grid>
                            <TextBlock Text="$" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Opacity="0.5" />
                            <Border Width="16" Height="16" CornerRadius="2" Background="{StaticResource SidebarBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                                <TextBlock Text="⚿" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Button Classes="sidebarIcon" ToolTip.Tip="{loc:Tr 'Paramètres'}" Command="{Binding ToggleSettingsCommand}">
                        <TextBlock Text="⚙" Foreground="{StaticResource TextMutedBrush}" FontSize="17" />
                    </Button>
                    <!-- Voir GDD/demande utilisateur — "une page sur le launcher avec un i pour accéder au à propos". -->
                    <Button Classes="sidebarIcon" ToolTip.Tip="{loc:Tr 'À propos'}" Command="{Binding ToggleAboutCommand}">
                        <TextBlock Text="ℹ" Foreground="{StaticResource TextMutedBrush}" FontSize="17" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Zone principale. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="118" />
            </Grid.RowDefinitions>

            <!-- Barre du haut : titre + statut serveur, liseré acier en pied de zone. -->
            <Border x:Name="TopBarBorder" Grid.Row="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Tr 'AETHERIA'}" FontSize="21" FontWeight="Bold" Foreground="#E7E5E3" VerticalAlignment="Center" />
                        <Border Width="1" Height="18" Background="{StaticResource PanelBorderBrush}" Margin="14,0" />
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="3" Padding="10,5" Background="#131316" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Classes.pulse="{Binding IsServerOnline}"
                                         Fill="{Binding IsServerOnline, Converter={StaticResource OnlineStatusColorConverter}}" />
                                <TextBlock Text="{Binding ServerStatusText}" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" FontSize="12.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Corps : formulaire (connexion/personnages) à gauche, actualités à droite. -->
            <Grid x:Name="BodyGrid" Grid.Row="1" Margin="28,20,28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Classes="overlayCard" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Écran de connexion / inscription -->
                            <StackPanel x:Name="LoginPanel" behaviors:FadeInBehavior.Enable="True"
                                        IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{loc:Tr 'Connexion'}" FontSize="19" FontWeight="Bold" Foreground="#E7E5E3" Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Tr 'Entrez dans le monde d\'Aetheria'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20" />

                                <TextBlock Text="{loc:Tr 'PSEUDO OU EMAIL'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                                <TextBox Text="{Binding UsernameOrEmail}" Margin="0,0,0,14" />

                                <TextBlock Text="{loc:Tr 'EMAIL (INSCRIPTION UNIQUEMENT)'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Email}" Margin="0,0,0,14" />

                                <TextBlock Text="{loc:Tr 'MOT DE PASSE'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                                <Grid Margin="0,0,0,22">
                                    <!-- Un seul champ (contre PasswordBox+TextBox superposés côté WPF) :
                                         TextBox.Text est directement bindable côté Avalonia, pas
                                         besoin de synchronisation manuelle (voir MainWindow.axaml.cs). -->
                                    <TextBox Padding="12,9,34,9" Text="{Binding Password}"
                                             PasswordChar="{Binding IsPasswordVisible, Converter={StaticResource PasswordCharConverter}}" />
                                    <!-- Voir retour utilisateur — "au launcher pouvoir voir le mot de passe que l'on tape". -->
                                    <Button Content="👁" FontSize="14" Click="OnTogglePasswordVisibility"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,0" Margin="0,0,4,0" Cursor="Hand" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{loc:Tr 'Se connecter'}" Command="{Binding LoginCommand}" Classes="secondary" Margin="0,0,10,0" />
                                    <Button Content="{loc:Tr 'Créer un compte'}" Command="{Binding RegisterCommand}" Classes="secondary" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Compte connecté : le personnage se choisit/se crée EN JEU (voir GDD),
                                 pas ici — le Launcher n'a plus qu'à proposer de lancer le jeu. -->
                            <StackPanel x:Name="CharacterPanel" VerticalAlignment="Center" behaviors:FadeInBehavior.Enable="True"
                                        IsVisible="{Binding IsLoggedIn}">
                                <!-- Voir Docs/Idees.md — vraie image de profil : pastille couleur+initiale en
                                     repli (fonction du pseudo tapé au dernier login), vraie image dès que
                                     CurrentAvatarUrl est renseigné. -->
                                <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Border CornerRadius="36" Background="{Binding UsernameOrEmail, Converter={StaticResource AvatarColorConverter}}"
                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                        <TextBlock Text="{Binding UsernameOrEmail, Converter={StaticResource AvatarInitialConverter}}"
                                                   FontSize="26" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Ellipse IsVisible="{Binding CurrentAvatarUrl, Converter={StaticResource StringNotEmptyToBool}}"
                                             Stroke="{StaticResource AccentBrush}" StrokeThickness="2">
                                        <Ellipse.Fill>
                                            <ImageBrush Source="{Binding CurrentAvatarUrl, Converter={StaticResource AvatarBitmapConverter}}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <Button Content="{loc:Tr 'Changer d\'avatar'}" Command="{Binding UploadAvatarCommand}" Classes="secondary"
                                        HorizontalAlignment="Center" Margin="0,0,0,4" FontSize="11.5" Padding="10,5" />
                                <TextBlock Text="{Binding AvatarUploadError}" IsVisible="{Binding AvatarUploadError, Converter={StaticResource StringNotEmptyToBool}}"
                                           Foreground="#D96464" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                                <TextBlock Text="{loc:Tr 'Compte connecté'}" FontSize="17" FontWeight="Bold" Foreground="#E7E5E3"
                                           HorizontalAlignment="Center" Margin="0,14,0,10" />
                                <TextBlock Text="{loc:Tr 'La sélection et la création de personnage se font en jeu, juste après le lancement.'}"
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22" />

                                <Button Content="{loc:Tr 'Déconnexion'}" Command="{Binding LogoutCommand}" Classes="secondary"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Actualités : cliquables pour le détail, avec accès à l'historique complet (voir GDD). -->
                <Border Grid.Column="2" Classes="overlayCard" Padding="24">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="✎" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr 'ACTUALITÉS'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr 'Voir toutes les actualités'}" Command="{Binding ToggleAllNewsCommand}"
                                Classes="secondary" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding RecentNews}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Barre du bas : message de statut + gros bouton JOUER, liseré acier en tête de zone. -->
            <Border x:Name="BottomBarBorder" Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="480" />
                        <TextBlock Text="{loc:Tr 'Chargement...'}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsVisible="{Binding IsBusy}" />
                    </StackPanel>

                    <Button Content="{loc:Tr 'JOUER'}" Command="{Binding PlayCommand}" Classes="primary"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="190" Height="58"
                            IsVisible="{Binding ShowPlayButton}" />

                    <!-- Le serveur tourne une version différente de ce Launcher (voir GDD/demande
                         utilisateur — "si la dernière mise à jour n'est pas faite on ne puisse pas
                         lancer le jeu et ça nous demande de faire la mise à jour") : JOUER disparaît
                         totalement (voir ShowPlayButton/ShowUpdateButton, MainViewModel — CanPlay()
                         renvoie faux tant qu'une mise à jour est disponible), remplacé par ce bouton
                         qui télécharge et applique la mise à jour lui-même (voir SelfUpdateService). -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                IsVisible="{Binding ShowUpdateButton}">
                        <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}"
                                Classes="primary" Width="230" Height="58" />
                        <TextBlock Text="{Binding ServerVersion, StringFormat='Version {0} disponible'}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   MaxWidth="230" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Panneau Paramètres : superposé à tout le reste tant qu'ouvert, avec fondu d'apparition. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsSettingsOpen}">
                <Border Classes="overlayCard" Width="440" Height="440" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr 'Paramètres'}" FontSize="18" FontWeight="Bold" Foreground="#E7E5E3" Margin="0,0,0,18" />

                        <TextBlock Text="{loc:Tr 'DISPOSITION CLAVIER'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableKeyboardLayouts}" SelectedItem="{Binding KeyboardLayoutPreference}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DetectedLayoutText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Tr 'Réglable aussi en jeu avec la touche F9.'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,18" />

                        <!-- Voir GDD/demande utilisateur — "ajoute un parametre pour changer la langue...
                             francais (actuel), japonais, anglais". Japonais absent de la liste (voir
                             AvailableLanguages) — pas de police japonaise dans le jeu pour l'instant. -->
                        <TextBlock Text="{loc:Tr 'LANGUE / LANGUAGE'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding LanguagePreference}" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Tr 'Japonais bientôt disponible (police non supportée pour l\'instant).'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <!-- Voir GDD/demande utilisateur — "quand on n'est pas modérateur, l'adresse du
                             serveur ne doit pas être affichée" : tout le bloc (pas juste l'édition,
                             déjà réservée à IsAdminAccount) est masqué pour les comptes non-staff. -->
                        <StackPanel IsVisible="{Binding IsStaffAccount}">
                            <TextBlock Text="{loc:Tr 'ADRESSE DU SERVEUR'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ServerHost, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsFondateurAccount}" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Tr 'IP publique ou nom de domaine du serveur — fonctionne en local comme depuis un autre réseau.'}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <!-- Voir GDD/demande utilisateur — "seul le compte admin (grade fondateur) peut modifier l'adresse du serveur". -->
                            <TextBlock Text="{loc:Tr 'Réservé au compte Fondateur.'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       IsVisible="{Binding IsFondateurAccount, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,22" />
                        </StackPanel>

                        <Button Content="{loc:Tr 'Fermer'}" Command="{Binding ToggleSettingsCommand}" Classes="secondary" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Panneau À propos : voir GDD/demande utilisateur — "une page sur le launcher avec
                 un i pour accéder au à propos, avec un bouton pour aller sur les CGU du site" +
                 crédits (créé par/code par/logo/musique/graphisme). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsAboutOpen}">
                <Border Classes="overlayCard" Width="420" Height="580" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                                   Foreground="#E7E5E3" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr 'Un MMORPG tactique de créatures et de royaumes.'}"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr 'Fermer'}" Command="{Binding ToggleAboutCommand}"
                                Classes="secondary" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr 'Conditions générales d\'utilisation'}" Command="{Binding OpenTermsOfServiceCommand}"
                                Classes="secondary" HorizontalAlignment="Center" Margin="0,10,0,0" />

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{loc:Tr 'Créé par feelsman'}" Foreground="#E7E5E3" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Tr 'Code par feelsman'}" Foreground="#E7E5E3" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Tr 'Logo par Korbak'}" Foreground="#E7E5E3" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Tr 'Musique par Konss'}" Foreground="#E7E5E3" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Tr 'Graphisme par feelsman'}" Foreground="#E7E5E3" Margin="0,0,0,8" />

                            <!-- Voir demande utilisateur — "dans le launcher et sur le site ajoute
                                 les contact les reseaux" : réutilise OpenCreatorLinkCommand (ouvre
                                 une URL via le navigateur/client mail par défaut). -->
                            <TextBlock Text="{loc:Tr 'Réseaux'}" Foreground="{StaticResource TextMutedBrush}"
                                       FontWeight="Bold" Margin="0,10,0,6" />
                            <Button Content="Discord" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding DiscordUrl}" Classes="link" Margin="0,0,0,4" />
                            <Button Content="TikTok" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding TikTokUrl}" Classes="link" Margin="0,0,0,4" />
                            <Button Content="YouTube" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding YouTubeUrl}" Classes="link" Margin="0,0,0,4" />
                            <Button Content="{Binding ContactEmail}" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding ContactMailUrl}" Classes="link" Margin="0,0,0,4" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Fiche créateur : voir GDD/demande utilisateur — "dans le launcher quand on appuie
                 sur un pseudo on doit avoir ses réseaux et les liens pour y accéder" (clic sur le
                 pseudo dans le panel Communauté, voir ShowCreatorInfoCommand). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsCreatorInfoOpen}">
                <Border Classes="overlayCard" Width="380" Height="260" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding CreatorInfo.DisplayName}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,18" />
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr 'Fermer'}" Command="{Binding CloseCreatorInfoCommand}"
                                Classes="secondary" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <StackPanel VerticalAlignment="Top">
                            <Button Content="{Binding CreatorInfo.Discord, StringFormat='Discord : {0}'}" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding CreatorInfo.Discord}" Classes="link" Margin="0,0,0,4" />
                            <Button Content="{Binding CreatorInfo.Twitch, StringFormat='Twitch : {0}'}" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding CreatorInfo.Twitch}" Classes="link" Margin="0,0,0,4" />
                            <Button Content="{Binding CreatorInfo.YouTube, StringFormat='YouTube : {0}'}" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding CreatorInfo.YouTube}" Classes="link" Margin="0,0,0,4" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Panneau Classement : voir GDD/demande utilisateur — "un bouton pour le leaderboard
                 en jeu et sur le launcher". -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsLeaderboardOpen}">
                <Border Classes="overlayCard" Width="420" Height="420" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr 'Classement'}" FontSize="18" FontWeight="Bold" Foreground="#E7E5E3" Margin="0,0,0,12" />

                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding AvailableLeaderboardCategories}"
                                  SelectedItem="{Binding SelectedLeaderboardCategory}" Margin="0,0,0,12" />

                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr 'Fermer'}" Command="{Binding ToggleLeaderboardCommand}"
                                Classes="secondary" HorizontalAlignment="Center" Margin="0,12,0,0" />

                        <ListBox ItemsSource="{Binding LeaderboardRows}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#E7E5E3" FontSize="13" Margin="0,3">
                                        <Run Text="{Binding Rank, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=". " />
                                        <Run Text="{Binding CharacterName, Mode=OneWay}" />
                                        <Run Text=" — " Foreground="{StaticResource TextMutedBrush}" />
                                        <Run Text="{Binding Score, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Panneau "Communauté" (administration) : voir GDD/demande utilisateur — grade,
                 mute, ban de compte/IP, réinitialisation de profil, renommage, réservés aux
                 comptes admin/fondateur (bouton masqué sinon, voir IsAdminAccount). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsAdminPanelOpen}">
                <Border Classes="overlayCard" Width="920" Height="590" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr 'Communauté — Administration'}" FontSize="18" FontWeight="Bold"
                                       Foreground="#E7E5E3" Margin="0,0,0,12" />

                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="{loc:Tr 'Copier tous les emails'}" Command="{Binding AdminCopyAllEmailsCommand}"
                                        Classes="secondary" Margin="8,0,0,0"
                                        ToolTip.Tip="{loc:Tr 'Copie les emails ci-dessous, séparés par des virgules — à coller dans le champ Cci de Gmail pour écrire à tout le monde'}" />
                                <TextBox DockPanel.Dock="Left" Width="240" Padding="10,7"
                                         Text="{Binding AdminSearchText}" />
                                <Button DockPanel.Dock="Left" Content="{loc:Tr 'Rechercher'}" Command="{Binding AdminSearchCommand}"
                                        Classes="secondary" Margin="8,0,0,0" />
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding AdminUsers}" SelectedItem="{Binding AdminSelectedUser}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="24" Height="24" ToolTip.Tip="{Binding IsOnline, StringFormat='En ligne : {0}'}">
                                                    <!-- Voir Docs/Idees.md — vraie image de profil : pastille couleur+initiale
                                                         en repli, remplacée par la vraie image dès qu'AvatarUrl est renseigné. -->
                                                    <Ellipse Fill="{Binding Username, Converter={StaticResource AvatarColorConverter}}" />
                                                    <TextBlock Text="{Binding Username, Converter={StaticResource AvatarInitialConverter}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="11" FontWeight="Bold" Foreground="White" />
                                                    <Ellipse IsVisible="{Binding AvatarUrl, Converter={StaticResource StringNotEmptyToBool}}">
                                                        <Ellipse.Fill>
                                                            <ImageBrush Source="{Binding AvatarUrl, Converter={StaticResource AvatarBitmapConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Fill="{Binding IsOnline, Converter={StaticResource OnlineStatusColorConverter}}"
                                                             Stroke="#101116" StrokeThickness="1.5" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Voir GDD/demande utilisateur — "quand on appuie sur un pseudo on doit avoir ses réseaux et les liens pour y accéder" : bouton plutôt qu'un simple texte, mais visuellement identique (pas de style de bouton) pour ne pas laisser croire que TOUS les pseudos ont une fiche (voir ShowCreatorInfoCommand, silencieux si le pseudo n'est pas reconnu). -->
                                    <DataGridTemplateColumn Header="{loc:Tr 'Pseudo'}" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Username}" Classes="link"
                                                        Command="{Binding $parent[DataGrid].DataContext.ShowCreatorInfoCommand}"
                                                        CommandParameter="{Binding Username}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Tr 'Email'}" Binding="{Binding Email}" Width="170" />
                                    <DataGridTextColumn Header="{loc:Tr 'Grade'}" Binding="{Binding Rank}" Width="90" />
                                    <DataGridTextColumn Header="{loc:Tr 'Banni'}" Binding="{Binding IsBanned}" Width="50" />
                                    <DataGridTextColumn Header="{loc:Tr 'Muet'}" Binding="{Binding IsMuted}" Width="45" />
                                    <DataGridTextColumn Header="{loc:Tr 'Derniere IP'}" Binding="{Binding LastKnownIp}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Grid (pas StackPanel) : une StackPanel ne borne pas la hauteur de son
                             contenu, donc le ScrollViewer ci-dessous ne voyait jamais de
                             dépassement réel et n'affichait aucune barre de défilement utilisable
                             (voir retour utilisateur — panneau des paramètres du joueur
                             sélectionné). La ligne "*" borne réellement le ScrollViewer, "Auto"
                             garde le bouton Fermer à taille fixe sous la zone défilante. -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'Bannissement'}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminBanReason}" Padding="10,7" Margin="0,0,0,8"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                                    <Button Content="{loc:Tr 'Bannir le compte'}" Command="{Binding AdminBanCommand}" Classes="secondary" Margin="0,0,0,6" />
                                    <Button Content="{loc:Tr 'Débannir le compte'}" Command="{Binding AdminUnbanCommand}" Classes="secondary" Margin="0,0,0,6" />
                                    <Button Content="{loc:Tr 'Bannir la dernière IP'}" Command="{Binding AdminBanIpCommand}" Classes="secondary" />

                                    <Separator Margin="0,14,0,10" Background="{StaticResource PanelBorderBrush}" />

                                    <TextBlock Text="{loc:Tr 'Grade'}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding AdminAvailableRanks}" SelectedItem="{Binding AdminSelectedRank}" Margin="0,0,0,6" />
                                    <Button Content="{loc:Tr 'Définir le grade'}" Command="{Binding AdminSetRankCommand}" Classes="secondary" />

                                    <Separator Margin="0,14,0,10" Background="{StaticResource PanelBorderBrush}" />

                                    <TextBlock Text="{loc:Tr 'Modération'}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <Button Content="{loc:Tr 'Basculer mute (tchat)'}" Command="{Binding AdminToggleMuteCommand}" Classes="secondary" Margin="0,0,0,6" />
                                    <Button Content="{loc:Tr 'Réinitialiser le profil de jeu'}" Command="{Binding AdminResetProfileCommand}" Classes="secondary" />

                                    <Separator Margin="0,14,0,10" Background="{StaticResource PanelBorderBrush}" />

                                    <TextBlock Text="{loc:Tr 'Renommer / changer l\'email'}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminNewUsername}" Padding="10,7" Margin="0,0,0,6" />
                                    <TextBlock Text="{loc:Tr 'Nouveau pseudo (laisser vide si inchangé)'}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminNewEmail}" Padding="10,7" Margin="0,0,0,6" />
                                    <TextBlock Text="{loc:Tr 'Nouvel email (laisser vide si inchangé)'}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" />
                                    <Button Content="{loc:Tr 'Enregistrer'}" Command="{Binding AdminModifyCommand}" Classes="secondary" />

                                    <TextBlock Text="{Binding AdminStatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                    <TextBlock Text="{loc:Tr 'Chargement...'}" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding AdminIsBusy}" Margin="0,8,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Row="1" Content="{loc:Tr 'Fermer'}" Command="{Binding ToggleAdminPanelCommand}" Classes="secondary"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Panneau "Signalements" : voir GDD/demande utilisateur — "les admin peut voir les
                 report sur une page sur le launcher", réservé aux comptes admin/fondateur (bouton
                 masqué sinon, voir IsAdminAccount). Lecture seule ici (pas de téléportation
                 possible depuis le Launcher, contrairement au panneau en jeu — voir
                 DrawReportsPanel côté Client) : seulement la liste et le marquage "traité".-->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsReportsPanelOpen}">
                <Border Classes="overlayCard" Width="760" Height="540" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr 'Signalements de joueurs'}" FontSize="18" FontWeight="Bold"
                                   Foreground="#E7E5E3" Margin="0,0,0,12" />
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr 'Fermer'}" Command="{Binding ToggleReportsPanelCommand}"
                                Classes="secondary" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ReportsStatusMessage}"
                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Tr 'Chargement...'}" Foreground="{StaticResource TextMutedBrush}"
                                   IsVisible="{Binding ReportsIsBusy}" Margin="0,8,0,0" />
                        <DataGrid ItemsSource="{Binding Reports}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr 'Signalé'}" Binding="{Binding ReportedCharacterName}" Width="130" />
                                <DataGridTextColumn Header="{loc:Tr 'Signalé par'}" Binding="{Binding ReporterCharacterName}" Width="130" />
                                <DataGridTextColumn Header="{loc:Tr 'Raison'}" Binding="{Binding Reason}" Width="*" />
                                <DataGridTextColumn Header="{loc:Tr 'Date (UTC)'}" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130" />
                                <DataGridCheckBoxColumn Header="{loc:Tr 'Traité'}" Binding="{Binding Resolved}" Width="55" />
                                <DataGridTemplateColumn Header="" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Tr 'Marquer traité'}" Classes="link"
                                                    Command="{Binding $parent[DataGrid].DataContext.ResolveReportCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Toutes les actualités. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsAllNewsOpen}">
                <Border Classes="overlayCard" Width="560" Height="480" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr 'TOUTES LES ACTUALITÉS'}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr 'Fermer'}" Command="{Binding ToggleAllNewsCommand}"
                                Classes="secondary" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AllNews}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Détail d'une actualité (au-dessus de "Toutes les actualités" si ouvert depuis là). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    IsVisible="{Binding IsNewsDetailOpen}">
                <Border Classes="overlayCard" Width="560" MaxHeight="480" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedNews.Title}" FontSize="20" FontWeight="Bold" Foreground="#E7E5E3" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedNews.PublishedLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,16" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SelectedNews.FullContent}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <Button Content="{loc:Tr 'Fermer'}" Command="{Binding CloseNewsDetailCommand}" Classes="secondary"
                                HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>

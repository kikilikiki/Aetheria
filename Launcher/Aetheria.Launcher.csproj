<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aetheria.Launcher : launcher Windows (login, inscription, téléchargement, mises à jour). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Aetheria.Launcher</RootNamespace>
    <AssemblyName>Aetheria.Launcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Aetheria.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>

<Window x:Class="Aetheria.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aetheria.Launcher"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="680" Width="1040"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D13"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <SolidColorBrush x:Key="PanelBrush" Color="#151822" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#262B3A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E8A93C" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#B87F1E" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8FA3" />

        <!-- Champs de saisie sombres cohérents avec le reste du thème (les contrôles WPF par
             défaut sont clairs et jureraient avec un launcher façon Ankama/Dofus). -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CaretBrush" Value="#E8E8F0" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CaretBrush" Value="#E8E8F0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Bouton standard (secondaire) : coins arrondis, sobre. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2330" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gros bouton d'action principal ("JOUER" façon Ankama) : dégradé doré, très arrondi. -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#241704" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="28" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F5C15C" Offset="0" />
                                    <GradientStop Color="#DB9A2E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icône décorative de la barre latérale (cosmétique, pas de navigation multi-page dans
             cette première version — voir Docs/README.md). -->
        <Style x:Key="SidebarIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Même look que SidebarIcon, mais cliquable (utilisé pour Paramètres). -->
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale façon Ankama : logo + icônes décoratives. -->
        <Border Grid.Column="0" Background="#05060A">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,0,28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F5C15C" Offset="0" />
                            <GradientStop Color="#B87F1E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="A" FontWeight="Bold" FontSize="20" Foreground="#241704"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Style="{StaticResource SidebarIcon}" ToolTip="Accueil">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>
                <Border Style="{StaticResource SidebarIcon}" ToolTip="Communauté">
                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>
                <Border Style="{StaticResource SidebarIcon}" ToolTip="Boutique">
                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>
                <Button Style="{StaticResource SidebarIconButton}" ToolTip="Paramètres" Command="{Binding ToggleSettingsCommand}">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}" FontSize="16" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Zone principale. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="112" />
            </Grid.RowDefinitions>

            <!-- Barre du haut : titre + statut serveur. -->
            <Grid Grid.Row="0" Margin="24,0">
                <TextBlock Text="AETHERIA" FontSize="20" FontWeight="Bold" Foreground="#E8E8F0"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D95A5A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerOnline}" Value="True">
                                        <Setter Property="Fill" Value="#5AD97E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServerStatusText}" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Corps : formulaire (connexion/personnages) à gauche, actualités à droite. -->
            <Grid Grid.Row="1" Margin="24,8,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Écran de connexion / inscription -->
                            <StackPanel x:Name="LoginPanel"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Connexion" FontSize="17" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,16" />

                                <TextBlock Text="Pseudo ou email" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                                <TextBox Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Email (inscription uniquement)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Mot de passe" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,18" PasswordChanged="OnPasswordChanged" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Se connecter" Command="{Binding LoginCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Créer un compte" Command="{Binding RegisterCommand}" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Compte connecté : le personnage se choisit/se crée EN JEU (voir GDD),
                                 pas ici — le Launcher n'a plus qu'à proposer de lancer le jeu. -->
                            <StackPanel x:Name="CharacterPanel" VerticalAlignment="Center"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Compte connecté" FontSize="17" FontWeight="Bold" Foreground="#E8E8F0"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="La sélection et la création de personnage se font en jeu, juste après le lancement."
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                                <Button Content="Déconnexion" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Actualités : contenu statique de démonstration (voir Docs/README.md). -->
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="ACTUALITÉS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />

                        <Border Background="#1B1F2C" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Le monde d'Aetheria s'agrandit" FontWeight="Bold" Foreground="#E8E8F0" TextWrapping="Wrap" />
                                <TextBlock Text="Nouvelle carte, bâtiments visitables, PNJ et donjon de test à explorer dès aujourd'hui."
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Background="#1B1F2C" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Choisissez votre premier compagnon" FontWeight="Bold" Foreground="#E8E8F0" TextWrapping="Wrap" />
                                <TextBlock Text="Une dizaine de créatures communes vous attendent pour débuter votre collection."
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Background="#1B1F2C" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Guerres de royaumes" FontWeight="Bold" Foreground="#E8E8F0" TextWrapping="Wrap" />
                                <TextBlock Text="Rejoignez un royaume et participez aux batailles pour le contrôle des territoires."
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Barre du bas : message de statut + gros bouton JOUER. -->
            <Border Grid.Row="2" Background="#05060A">
                <Grid Margin="24,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#F0A0A0" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="480" />
                        <TextBlock Text="Chargement..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Button Content="JOUER" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryActionButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="180" Height="56"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- Panneau Paramètres : superposé à tout le reste tant qu'ouvert. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Width="420" Height="260"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Paramètres" FontSize="18" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,18" />

                        <TextBlock Text="Disposition clavier" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableKeyboardLayouts}" SelectedItem="{Binding KeyboardLayoutPreference}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DetectedLayoutText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <TextBlock Text="Réglable aussi en jeu avec la touche F9." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,22" />

                        <Button Content="Fermer" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>

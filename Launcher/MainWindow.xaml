<Window x:Class="Aetheria.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aetheria.Launcher"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="680" Width="1040"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D13"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:UsernameToAvatarColorConverter x:Key="AvatarColorConverter" />
        <local:UsernameToInitialConverter x:Key="AvatarInitialConverter" />

        <SolidColorBrush x:Key="PanelBrush" Color="#151822" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#262B3A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E8A93C" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#B87F1E" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8FA3" />

        <!-- Champs de saisie sombres cohérents avec le reste du thème (les contrôles WPF par
             défaut sont clairs et jureraient avec un launcher façon Ankama/Dofus). -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CaretBrush" Value="#E8E8F0" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CaretBrush" Value="#E8E8F0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <!-- Le popup déroulant du ComboBox ne reprend pas le thème sombre par défaut (fond clair
             hérité du système) alors que le texte hérite quand même du Foreground clair du
             ComboBox fermé — texte clair sur fond clair, illisible (voir retour utilisateur).
             Style explicite des lignes du menu déroulant pour corriger ça. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2A3040" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#333A4D" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#1B1F2C" />
            <Setter Property="AlternatingRowBackground" Value="#20253400" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#151822" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A3040" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton standard (secondaire) : coins arrondis, sobre. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2330" />
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gros bouton d'action principal ("JOUER" façon Ankama) : dégradé doré, très arrondi. -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#241704" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="28" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F5C15C" Offset="0" />
                                    <GradientStop Color="#DB9A2E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icône décorative de la barre latérale (cosmétique, pas de navigation multi-page dans
             cette première version — voir Docs/README.md). -->
        <Style x:Key="SidebarIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Même look que SidebarIcon, mais cliquable (utilisé pour Paramètres). -->
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte actualité cliquable (voir GDD — détail au clic). -->
        <Style x:Key="NewsCardButton" TargetType="Button">
            <Setter Property="Background" Value="#1B1F2C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="14">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#232838" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="NewsCardTemplate">
            <Button Style="{StaticResource NewsCardButton}"
                    Command="{Binding DataContext.OpenNewsDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#E8E8F0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ShortDescription}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                    <TextBlock Text="{Binding PublishedLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale façon Ankama : logo + icônes décoratives. -->
        <Border Grid.Column="0" Background="#05060A">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,0,28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F5C15C" Offset="0" />
                            <GradientStop Color="#B87F1E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="A" FontWeight="Bold" FontSize="20" Foreground="#241704"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Style="{StaticResource SidebarIcon}" ToolTip="Accueil">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>
                <!-- Réservé aux comptes admin/fondateur (voir GDD/demande utilisateur — panneau
                     d'administration accessible depuis le Launcher, "seulement pour les admin/
                     fonda") : masqué pour tout le monde d'autre. -->
                <Button Style="{StaticResource SidebarIconButton}" ToolTip="Communauté (administration)"
                        Command="{Binding ToggleAdminPanelCommand}"
                        Visibility="{Binding IsAdminAccount, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Button>
                <Border Style="{StaticResource SidebarIcon}" ToolTip="Boutique">
                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>
                <Button Style="{StaticResource SidebarIconButton}" ToolTip="Paramètres" Command="{Binding ToggleSettingsCommand}">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}" FontSize="16" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Zone principale. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="112" />
            </Grid.RowDefinitions>

            <!-- Barre du haut : titre + statut serveur. -->
            <Grid Grid.Row="0" Margin="24,0">
                <TextBlock Text="AETHERIA" FontSize="20" FontWeight="Bold" Foreground="#E8E8F0"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D95A5A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerOnline}" Value="True">
                                        <Setter Property="Fill" Value="#5AD97E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServerStatusText}" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Corps : formulaire (connexion/personnages) à gauche, actualités à droite. -->
            <Grid Grid.Row="1" Margin="24,8,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Écran de connexion / inscription -->
                            <StackPanel x:Name="LoginPanel"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Connexion" FontSize="17" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,16" />

                                <TextBlock Text="Pseudo ou email" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                                <TextBox Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Email (inscription uniquement)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Mot de passe" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,18" PasswordChanged="OnPasswordChanged" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Se connecter" Command="{Binding LoginCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Créer un compte" Command="{Binding RegisterCommand}" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Compte connecté : le personnage se choisit/se crée EN JEU (voir GDD),
                                 pas ici — le Launcher n'a plus qu'à proposer de lancer le jeu. -->
                            <StackPanel x:Name="CharacterPanel" VerticalAlignment="Center"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Compte connecté" FontSize="17" FontWeight="Bold" Foreground="#E8E8F0"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="La sélection et la création de personnage se font en jeu, juste après le lancement."
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                                <Button Content="Déconnexion" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Actualités : cliquables pour le détail, avec accès à l'historique complet (voir GDD). -->
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ACTUALITÉS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />
                        <Button DockPanel.Dock="Bottom" Content="Voir toutes les actualités" Command="{Binding ToggleAllNewsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding RecentNews}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Barre du bas : message de statut + gros bouton JOUER. -->
            <Border Grid.Row="2" Background="#05060A">
                <Grid Margin="24,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#F0A0A0" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="480" />
                        <TextBlock Text="Chargement..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Button Content="JOUER" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryActionButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="180" Height="56"
                            Visibility="{Binding ShowPlayButton, Converter={StaticResource BoolToVis}}" />

                    <!-- Le serveur tourne une version differente de ce Launcher (voir GDD/demande
                         utilisateur — "obligé de faire la dernière mise à jour pour lancer le
                         jeu") : bloque JOUER, le bouton télécharge et applique la mise à jour lui-
                         même (voir SelfUpdateService), texte "Mise à jour" / "Mise à jour en cours
                         (X%)" pendant l'opération. -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}">
                        <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}"
                                Style="{StaticResource PrimaryActionButton}" Width="220" Height="56" />
                        <TextBlock Text="{Binding ServerVersion, StringFormat='Version {0} disponible'}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   MaxWidth="220" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Panneau Paramètres : superposé à tout le reste tant qu'ouvert. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Width="420" Height="340"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Paramètres" FontSize="18" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,18" />

                        <TextBlock Text="Disposition clavier" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableKeyboardLayouts}" SelectedItem="{Binding KeyboardLayoutPreference}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DetectedLayoutText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <TextBlock Text="Réglable aussi en jeu avec la touche F9." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,18" />

                        <TextBlock Text="Adresse du serveur" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" FontSize="12" />
                        <TextBox Text="{Binding ServerHost, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsAdminAccount}" Margin="0,0,0,6" />
                        <TextBlock Text="IP publique ou nom de domaine du serveur — fonctionne en local comme depuis un autre réseau."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <!-- Voir GDD/demande utilisateur — "seul le compte admin (grade fondateur) peut modifier l'adresse du serveur". -->
                        <TextBlock Text="Réservé au compte Fondateur." Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   Visibility="{Binding IsAdminAccount, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,22" />

                        <Button Content="Fermer" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Panneau "Communauté" (administration) : voir GDD/demande utilisateur — grade,
                 mute, ban de compte/IP, réinitialisation de profil, renommage, réservés aux
                 comptes admin/fondateur (bouton masqué sinon, voir IsAdminAccount). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsAdminPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Width="900" Height="580"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Communauté — Administration" FontSize="18" FontWeight="Bold"
                                       Foreground="#E8E8F0" Margin="0,0,0,12" />

                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBox DockPanel.Dock="Left" Width="240" Padding="6"
                                         Text="{Binding AdminSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button DockPanel.Dock="Left" Content="Rechercher" Command="{Binding AdminSearchCommand}"
                                        Padding="12,6" Margin="8,0,0,0" />
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding AdminUsers}" SelectedItem="{Binding AdminSelectedUser}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="24" Height="24" Fill="{Binding Username, Converter={StaticResource AvatarColorConverter}}">
                                                    <Ellipse.ToolTip>
                                                        <TextBlock Text="{Binding Username}" />
                                                    </Ellipse.ToolTip>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Pseudo" Binding="{Binding Username}" Width="110" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="170" />
                                    <DataGridTextColumn Header="Grade" Binding="{Binding Rank}" Width="90" />
                                    <DataGridTextColumn Header="Banni" Binding="{Binding IsBanned}" Width="50" />
                                    <DataGridTextColumn Header="Muet" Binding="{Binding IsMuted}" Width="45" />
                                    <DataGridTextColumn Header="Derniere IP" Binding="{Binding LastKnownIp}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Grid (pas StackPanel) : une StackPanel ne borne pas la hauteur de son
                             contenu, donc le ScrollViewer ci-dessous ne voyait jamais de
                             dépassement réel et n'affichait aucune barre de défilement utilisable
                             (voir retour utilisateur — panneau des paramètres du joueur
                             sélectionné). La ligne "*" borne réellement le ScrollViewer, "Auto"
                             garde le bouton Fermer à taille fixe sous la zone défilante. -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible">
                                <StackPanel>
                                    <TextBlock Text="Bannissement" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminBanReason, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                                    <Button Content="Bannir le compte" Command="{Binding AdminBanCommand}" Padding="14,7" Margin="0,0,0,6" />
                                    <Button Content="Débannir le compte" Command="{Binding AdminUnbanCommand}" Padding="14,7" Margin="0,0,0,6" />
                                    <Button Content="Bannir la dernière IP" Command="{Binding AdminBanIpCommand}" Padding="14,7" />

                                    <Separator Margin="0,14,0,10" />

                                    <TextBlock Text="Grade" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding AdminAvailableRanks}" SelectedItem="{Binding AdminSelectedRank}" Padding="6" Margin="0,0,0,6" />
                                    <Button Content="Définir le grade" Command="{Binding AdminSetRankCommand}" Padding="14,7" />

                                    <Separator Margin="0,14,0,10" />

                                    <TextBlock Text="Modération" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                                    <Button Content="Basculer mute (tchat)" Command="{Binding AdminToggleMuteCommand}" Padding="14,7" Margin="0,0,0,6" />
                                    <Button Content="Réinitialiser le profil de jeu" Command="{Binding AdminResetProfileCommand}" Padding="14,7" />

                                    <Separator Margin="0,14,0,10" />

                                    <TextBlock Text="Renommer / changer l'email" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminNewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,6" />
                                    <TextBlock Text="Nouveau pseudo (laisser vide si inchangé)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminNewEmail, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,6" />
                                    <TextBlock Text="Nouvel email (laisser vide si inchangé)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" />
                                    <Button Content="Enregistrer" Command="{Binding AdminModifyCommand}" Padding="14,7" />

                                    <TextBlock Text="{Binding AdminStatusMessage}" Foreground="#F0A0A0" TextWrapping="Wrap" Margin="0,14,0,0" />
                                    <TextBlock Text="Chargement..." Foreground="#A0A0B0" Visibility="{Binding AdminIsBusy, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Row="1" Content="Fermer" Command="{Binding ToggleAdminPanelCommand}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Toutes les actualités. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsAllNewsOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Width="560" Height="480"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TOUTES LES ACTUALITÉS" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />
                        <Button DockPanel.Dock="Bottom" Content="Fermer" Command="{Binding ToggleAllNewsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AllNews}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Détail d'une actualité (au-dessus de "Toutes les actualités" si ouvert depuis là). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsNewsDetailOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Width="560" MaxHeight="480"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedNews.Title}" FontSize="20" FontWeight="Bold" Foreground="#E8E8F0" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedNews.PublishedLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,16" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SelectedNews.FullContent}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <Button Content="Fermer" Command="{Binding CloseNewsDetailCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>

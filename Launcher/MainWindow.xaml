<Window x:Class="Aetheria.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aetheria.Launcher"
        xmlns:behaviors="clr-namespace:Aetheria.Launcher.Behaviors"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="700" Width="1080"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0C"
        FontFamily="Segoe UI">

    <!--
        Repasse visuelle (voir demande utilisateur — "sa fait beaucoup trop ia, je ne veux pas que
        sa soit les meme couleur et style graphique que les ia utilisé") : la précédente palette
        bleu marine + doré, les coins très arrondis partout et les lueurs floutées en fond sont un
        motif très reconnaissable des interfaces générées par IA — remplacés ici par une identité
        "acier + rouge sombre" (voir choix utilisateur), des coins nettement moins arrondis
        (silhouette plus anguleuse, moins "carte web"), plus aucune lueur floutée décorative, et
        une ombre portée DURE (décalage net, sans flou) sur le bouton principal plutôt que le halo
        flouté générique d'avant. Structure et bindings inchangés — voir MainViewModel.cs. La
        Boutique reste un Border (jamais un Button, jamais de Command) : visible mais impossible à
        atteindre, badge cadenas à l'appui.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:UsernameToAvatarColorConverter x:Key="AvatarColorConverter" />
        <local:UsernameToInitialConverter x:Key="AvatarInitialConverter" />

        <SolidColorBrush x:Key="PanelBrush" Color="#18181B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#37383D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A8353A" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#6E1F23" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#C4474B" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8B8C91" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E0483F" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#6FA37A" />
        <SolidColorBrush x:Key="FieldBrush" Color="#1D1E22" />
        <SolidColorBrush x:Key="FieldHoverBrush" Color="#26272C" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#08090A" />
        <SolidColorBrush x:Key="AccentGradientBrush" Color="#A8353A" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0A0C" />

        <!-- Champs de saisie : coins presque droits, halo rouge sombre au focus/survol. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="#E7E5E3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="#E7E5E3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1D1E22" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E7E5E3" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1D1E22" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7E5E3" />
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="Padding" Value="10,7" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#292325" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A2427" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{StaticResource FieldBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#1C1D21" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A2427" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton standard (secondaire) : échelle + couleur animées au survol/pression. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1F24" />
            <Setter Property="Foreground" Value="#E7E5E3" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BgScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2B31" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#151519" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton "lien" sans fond (fiche créateur, liens sociaux) : glissement + couleur
             accent animés au survol. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9C6C2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LinkOffset" X="0" />
                            </Border.RenderTransform>
                            <ContentPresenter x:Name="Cp" TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LinkOffset" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LinkOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gros bouton d'action principal ("JOUER"/"MISE À JOUR") : plaque rouge sombre avec
             ombre DURE décalée (pas de flou — voir demande utilisateur, éviter le halo flouté
             générique), surbrillance plate au survol plutôt qu'un glow. -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F3E9E9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border CornerRadius="3" Background="#050506" Margin="4,5,-4,-5" />
                            <Border x:Name="Bg" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="#A8353A"
                                    BorderBrush="#6E1F23" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="HoverOverlay" CornerRadius="3" Background="#C4474B" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Padding" Value="0,2,0,0" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icône décorative de la barre latérale (cosmétique — pas de navigation multi-page dans
             cette version, voir Docs/README.md). -->
        <Style x:Key="SidebarIcon" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#12162400" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Même look que SidebarIcon, mais cliquable — surbrillance + échelle animées au survol. -->
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D1E22" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte actualité cliquable : bande d'accent + léger soulèvement animés au survol. -->
        <Style x:Key="NewsCardButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1B1F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="14"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CardOffset" Y="0" />
                            </Border.RenderTransform>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#37383D" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Width="3" Margin="0,0,12,0"
                                        Background="{StaticResource AccentGradientBrush}" Opacity="0.55" />
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#212226" />
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardOffset" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardOffset" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NewsCardTemplate">
            <Button Style="{StaticResource NewsCardButton}"
                    Command="{Binding DataContext.OpenNewsDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#E7E5E3" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ShortDescription}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                    <TextBlock Text="{Binding PublishedLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- En-tête réutilisé par tous les panneaux superposés : coins presque droits, pas
             d'ombre portée floutée (voir demande utilisateur). -->
        <Style x:Key="OverlayCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Window.Resources>

    <!-- Entrée en scène : cascade fondu + glissement sur la barre latérale, la barre du haut, le
         corps puis la barre du bas. Ne concerne que le premier affichage de la fenêtre — les
         panneaux superposés utilisent FadeInBehavior pour rejouer leur propre fondu à chaque
         ouverture. -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SidebarBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0" />
                    <DoubleAnimation Storyboard.TargetName="SidebarTransform" Storyboard.TargetProperty="X" From="-24" To="0" Duration="0:0:0.4" BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="TopBarBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="TopBarTransform" Storyboard.TargetProperty="Y" From="-16" To="0" Duration="0:0:0.4" BeginTime="0:0:0.08">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="BodyGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="Y" From="18" To="0" Duration="0:0:0.45" BeginTime="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="BottomBarBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="BottomBarTransform" Storyboard.TargetProperty="Y" From="16" To="0" Duration="0:0:0.4" BeginTime="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale : logo + icônes, liseré acier vertical à droite. -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,1,0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarTransform" X="0" />
            </Border.RenderTransform>
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Height="1" Background="Transparent" />
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <!-- Emblème (pas une icône pleine couleur générique) : plaque sombre, liseré
                         rouge, lettre en accent — voir demande utilisateur, éviter le rond/carré
                         plein dégradé typique des logos générés par IA. -->
                    <Border Width="44" Height="44" CornerRadius="3" Margin="0,0,0,30" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="21" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border Style="{StaticResource SidebarIcon}" ToolTip="Accueil">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                    </Border>
                    <!-- Réservé aux comptes admin/fondateur (voir GDD/demande utilisateur — panneau
                         d'administration accessible depuis le Launcher, "seulement pour les admin/
                         fonda") : masqué pour tout le monde d'autre. -->
                    <Button Style="{StaticResource SidebarIconButton}" ToolTip="Communauté (administration)"
                            Command="{Binding ToggleAdminPanelCommand}"
                            Visibility="{Binding IsAdminAccount, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                    </Button>
                    <!-- Voir GDD/demande utilisateur — "un bouton pour le leaderboard en jeu et sur le launcher". -->
                    <Button Style="{StaticResource SidebarIconButton}" ToolTip="Classement" Command="{Binding ToggleLeaderboardCommand}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                    </Button>
                    <!-- Voir demande utilisateur — "garde la partie shop mais laisse la impossible à
                         accéder" : reste un Border décoratif (jamais un Button, aucune Command) —
                         badge cadenas ajouté pour rendre ce verrouillage explicite visuellement. -->
                    <Border Style="{StaticResource SidebarIcon}" ToolTip="Boutique (bientôt disponible ici)">
                        <Grid>
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Opacity="0.5" />
                            <Border Width="16" Height="16" CornerRadius="2" Background="{StaticResource SidebarBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource SidebarIconButton}" ToolTip="Paramètres" Command="{Binding ToggleSettingsCommand}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}" FontSize="17" />
                    </Button>
                    <!-- Voir GDD/demande utilisateur — "une page sur le launcher avec un i pour accéder au à propos". -->
                    <Button Style="{StaticResource SidebarIconButton}" ToolTip="À propos" Command="{Binding ToggleAboutCommand}">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}" FontSize="17" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Zone principale. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="118" />
            </Grid.RowDefinitions>

            <!-- Barre du haut : titre + statut serveur, liseré acier en pied de zone. -->
            <Border x:Name="TopBarBorder" Grid.Row="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TopBarTransform" Y="0" />
                </Border.RenderTransform>
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="AETHERIA" FontSize="21" FontWeight="Bold" Foreground="#E7E5E3" VerticalAlignment="Center" />
                        <Border Width="1" Height="18" Background="{StaticResource PanelBorderBrush}" Margin="14,0" />
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="3" Padding="10,5" Background="#131316" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="StatusPulseStoryboard">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.5" Duration="0:0:0.9" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.5" Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="StatusPulseStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ServerStatusText}" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" FontSize="12.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Corps : formulaire (connexion/personnages) à gauche, actualités à droite. -->
            <Grid x:Name="BodyGrid" Grid.Row="1" Margin="28,20,28,10" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="BodyTransform" Y="0" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource OverlayCard}" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Écran de connexion / inscription -->
                            <StackPanel x:Name="LoginPanel" behaviors:FadeInBehavior.Enable="True"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Connexion" FontSize="19" FontWeight="Bold" Foreground="#E7E5E3" Margin="0,0,0,4" />
                                <TextBlock Text="Entrez dans le monde d'Aetheria" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20" />

                                <TextBlock Text="PSEUDO OU EMAIL" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                                <TextBox Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                <TextBlock Text="EMAIL (INSCRIPTION UNIQUEMENT)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                <TextBlock Text="MOT DE PASSE" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,22" PasswordChanged="OnPasswordChanged" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Se connecter" Command="{Binding LoginCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                    <Button Content="Créer un compte" Command="{Binding RegisterCommand}" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Compte connecté : le personnage se choisit/se crée EN JEU (voir GDD),
                                 pas ici — le Launcher n'a plus qu'à proposer de lancer le jeu. -->
                            <StackPanel x:Name="CharacterPanel" VerticalAlignment="Center" behaviors:FadeInBehavior.Enable="True"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                                <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,18"
                                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Compte connecté" FontSize="17" FontWeight="Bold" Foreground="#E7E5E3"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="La sélection et la création de personnage se font en jeu, juste après le lancement."
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22" />

                                <Button Content="Déconnexion" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Actualités : cliquables pour le détail, avec accès à l'historique complet (voir GDD). -->
                <Border Grid.Column="2" Style="{StaticResource OverlayCard}" Padding="24">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="ACTUALITÉS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="Voir toutes les actualités" Command="{Binding ToggleAllNewsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding RecentNews}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Barre du bas : message de statut + gros bouton JOUER, liseré acier en tête de zone. -->
            <Border x:Name="BottomBarBorder" Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BottomBarTransform" Y="0" />
                </Border.RenderTransform>
                <Grid Margin="28,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="480" />
                        <TextBlock Text="Chargement..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Button Content="JOUER" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryActionButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="190" Height="58"
                            Visibility="{Binding ShowPlayButton, Converter={StaticResource BoolToVis}}" />

                    <!-- Le serveur tourne une version différente de ce Launcher (voir GDD/demande
                         utilisateur — "si la dernière mise à jour n'est pas faite on ne puisse pas
                         lancer le jeu et ça nous demande de faire la mise à jour") : JOUER disparaît
                         totalement (voir ShowPlayButton/ShowUpdateButton, MainViewModel — CanPlay()
                         renvoie faux tant qu'une mise à jour est disponible), remplacé par ce bouton
                         qui télécharge et applique la mise à jour lui-même (voir SelfUpdateService). -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}">
                        <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}"
                                Style="{StaticResource PrimaryActionButton}" Width="230" Height="58" />
                        <TextBlock Text="{Binding ServerVersion, StringFormat='Version {0} disponible'}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   MaxWidth="230" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Panneau Paramètres : superposé à tout le reste tant qu'ouvert, avec fondu d'apparition. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource OverlayCard}" Width="440" Height="360" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <StackPanel>
                        <TextBlock Text="Paramètres" FontSize="18" FontWeight="Bold" Foreground="#E7E5E3" Margin="0,0,0,18" />

                        <TextBlock Text="DISPOSITION CLAVIER" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableKeyboardLayouts}" SelectedItem="{Binding KeyboardLayoutPreference}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DetectedLayoutText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <TextBlock Text="Réglable aussi en jeu avec la touche F9." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,18" />

                        <!-- Voir GDD/demande utilisateur — "quand on n'est pas modérateur, l'adresse du
                             serveur ne doit pas être affichée" : tout le bloc (pas juste l'édition,
                             déjà réservée à IsAdminAccount) est masqué pour les comptes non-staff. -->
                        <StackPanel Visibility="{Binding IsStaffAccount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ADRESSE DU SERVEUR" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ServerHost, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsAdminAccount}" Margin="0,0,0,6" />
                            <TextBlock Text="IP publique ou nom de domaine du serveur — fonctionne en local comme depuis un autre réseau."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <!-- Voir GDD/demande utilisateur — "seul le compte admin (grade fondateur) peut modifier l'adresse du serveur". -->
                            <TextBlock Text="Réservé au compte Fondateur." Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       Visibility="{Binding IsAdminAccount, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,22" />
                        </StackPanel>

                        <Button Content="Fermer" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Panneau À propos : voir GDD/demande utilisateur — "une page sur le launcher avec
                 un i pour accéder au à propos, avec un bouton pour aller sur les CGU du site" +
                 crédits (créé par/code par/logo/musique/graphisme). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource OverlayCard}" Width="420" Height="430" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                                   Foreground="#E7E5E3" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Text="Un MMORPG tactique de créatures et de royaumes."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <Button DockPanel.Dock="Bottom" Content="Fermer" Command="{Binding ToggleAboutCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <Button DockPanel.Dock="Bottom" Content="Conditions générales d'utilisation" Command="{Binding OpenTermsOfServiceCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,10,0,0" />

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Créé par feelsman" Foreground="#E7E5E3" Margin="0,0,0,8" />
                            <TextBlock Text="Code par feelsman" Foreground="#E7E5E3" Margin="0,0,0,8" />
                            <TextBlock Text="Logo par —" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Musique par —" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Graphisme par feelsman" Foreground="#E7E5E3" Margin="0,0,0,8" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Fiche créateur : voir GDD/demande utilisateur — "dans le launcher quand on appuie
                 sur un pseudo on doit avoir ses réseaux et les liens pour y accéder" (clic sur le
                 pseudo dans le panel Communauté, voir ShowCreatorInfoCommand). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsCreatorInfoOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource OverlayCard}" Width="380" Height="260" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding CreatorInfo.DisplayName}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,18" />
                        <Button DockPanel.Dock="Bottom" Content="Fermer" Command="{Binding CloseCreatorInfoCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <StackPanel VerticalAlignment="Top">
                            <Button Content="{Binding CreatorInfo.Discord, StringFormat='Discord : {0}'}" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding CreatorInfo.Discord}" Style="{StaticResource LinkButton}" Margin="0,0,0,4" />
                            <Button Content="{Binding CreatorInfo.Twitch, StringFormat='Twitch : {0}'}" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding CreatorInfo.Twitch}" Style="{StaticResource LinkButton}" Margin="0,0,0,4" />
                            <Button Content="{Binding CreatorInfo.YouTube, StringFormat='YouTube : {0}'}" Command="{Binding OpenCreatorLinkCommand}"
                                    CommandParameter="{Binding CreatorInfo.YouTube}" Style="{StaticResource LinkButton}" Margin="0,0,0,4" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Panneau Classement : voir GDD/demande utilisateur — "un bouton pour le leaderboard
                 en jeu et sur le launcher". -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsLeaderboardOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource OverlayCard}" Width="420" Height="420" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Classement" FontSize="18" FontWeight="Bold" Foreground="#E7E5E3" Margin="0,0,0,12" />

                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding AvailableLeaderboardCategories}"
                                  SelectedItem="{Binding SelectedLeaderboardCategory}" Margin="0,0,0,12" />

                        <Button DockPanel.Dock="Bottom" Content="Fermer" Command="{Binding ToggleLeaderboardCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,12,0,0" />

                        <ListView ItemsSource="{Binding LeaderboardRows}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#E7E5E3" FontSize="13" Margin="0,3">
                                        <Run Text="{Binding Rank, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=". " />
                                        <Run Text="{Binding CharacterName, Mode=OneWay}" />
                                        <Run Text=" — " Foreground="{StaticResource TextMutedBrush}" />
                                        <Run Text="{Binding Score, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Panneau "Communauté" (administration) : voir GDD/demande utilisateur — grade,
                 mute, ban de compte/IP, réinitialisation de profil, renommage, réservés aux
                 comptes admin/fondateur (bouton masqué sinon, voir IsAdminAccount). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsAdminPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource OverlayCard}" Width="920" Height="590" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Communauté — Administration" FontSize="18" FontWeight="Bold"
                                       Foreground="#E7E5E3" Margin="0,0,0,12" />

                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBox DockPanel.Dock="Left" Width="240" Padding="10,7"
                                         Text="{Binding AdminSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button DockPanel.Dock="Left" Content="Rechercher" Command="{Binding AdminSearchCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding AdminUsers}" SelectedItem="{Binding AdminSelectedUser}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="24" Height="24" Fill="{Binding Username, Converter={StaticResource AvatarColorConverter}}">
                                                    <Ellipse.ToolTip>
                                                        <TextBlock Text="{Binding Username}" />
                                                    </Ellipse.ToolTip>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Voir GDD/demande utilisateur — "quand on appuie sur un pseudo on doit avoir ses réseaux et les liens pour y accéder" : bouton plutôt qu'un simple texte, mais visuellement identique (pas de style de bouton) pour ne pas laisser croire que TOUS les pseudos ont une fiche (voir ShowCreatorInfoCommand, silencieux si le pseudo n'est pas reconnu). -->
                                    <DataGridTemplateColumn Header="Pseudo" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Username}" Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.ShowCreatorInfoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Username}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="170" />
                                    <DataGridTextColumn Header="Grade" Binding="{Binding Rank}" Width="90" />
                                    <DataGridTextColumn Header="Banni" Binding="{Binding IsBanned}" Width="50" />
                                    <DataGridTextColumn Header="Muet" Binding="{Binding IsMuted}" Width="45" />
                                    <DataGridTextColumn Header="Derniere IP" Binding="{Binding LastKnownIp}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Grid (pas StackPanel) : une StackPanel ne borne pas la hauteur de son
                             contenu, donc le ScrollViewer ci-dessous ne voyait jamais de
                             dépassement réel et n'affichait aucune barre de défilement utilisable
                             (voir retour utilisateur — panneau des paramètres du joueur
                             sélectionné). La ligne "*" borne réellement le ScrollViewer, "Auto"
                             garde le bouton Fermer à taille fixe sous la zone défilante. -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible">
                                <StackPanel>
                                    <TextBlock Text="Bannissement" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminBanReason, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" Margin="0,0,0,8"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                                    <Button Content="Bannir le compte" Command="{Binding AdminBanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
                                    <Button Content="Débannir le compte" Command="{Binding AdminUnbanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
                                    <Button Content="Bannir la dernière IP" Command="{Binding AdminBanIpCommand}" Style="{StaticResource SecondaryButton}" />

                                    <Separator Margin="0,14,0,10" Background="{StaticResource PanelBorderBrush}" />

                                    <TextBlock Text="Grade" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding AdminAvailableRanks}" SelectedItem="{Binding AdminSelectedRank}" Margin="0,0,0,6" />
                                    <Button Content="Définir le grade" Command="{Binding AdminSetRankCommand}" Style="{StaticResource SecondaryButton}" />

                                    <Separator Margin="0,14,0,10" Background="{StaticResource PanelBorderBrush}" />

                                    <TextBlock Text="Modération" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <Button Content="Basculer mute (tchat)" Command="{Binding AdminToggleMuteCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
                                    <Button Content="Réinitialiser le profil de jeu" Command="{Binding AdminResetProfileCommand}" Style="{StaticResource SecondaryButton}" />

                                    <Separator Margin="0,14,0,10" Background="{StaticResource PanelBorderBrush}" />

                                    <TextBlock Text="Renommer / changer l'email" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminNewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" Margin="0,0,0,6" />
                                    <TextBlock Text="Nouveau pseudo (laisser vide si inchangé)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdminNewEmail, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" Margin="0,0,0,6" />
                                    <TextBlock Text="Nouvel email (laisser vide si inchangé)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" />
                                    <Button Content="Enregistrer" Command="{Binding AdminModifyCommand}" Style="{StaticResource SecondaryButton}" />

                                    <TextBlock Text="{Binding AdminStatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                    <TextBlock Text="Chargement..." Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding AdminIsBusy, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Row="1" Content="Fermer" Command="{Binding ToggleAdminPanelCommand}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Toutes les actualités. -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsAllNewsOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource OverlayCard}" Width="560" Height="480" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TOUTES LES ACTUALITÉS" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />
                        <Button DockPanel.Dock="Bottom" Content="Fermer" Command="{Binding ToggleAllNewsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AllNews}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Détail d'une actualité (au-dessus de "Toutes les actualités" si ouvert depuis là). -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#000000AA"
                    Visibility="{Binding IsNewsDetailOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource OverlayCard}" Width="560" MaxHeight="480" behaviors:FadeInBehavior.Enable="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedNews.Title}" FontSize="20" FontWeight="Bold" Foreground="#E7E5E3" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedNews.PublishedLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,16" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SelectedNews.FullContent}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <Button Content="Fermer" Command="{Binding CloseNewsDetailCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>

# Copiez ce fichier en ".env" (à la racine du dépôt) et remplissez vos propres valeurs.
# ".env" est ignoré par git (voir .gitignore) : n'y mettez jamais ce fichier ".exemple" à jour
# avec de vraies valeurs, modifiez uniquement votre copie locale ".env".

# Jeton du bot Discord utilisé pour poster les annonces de mise à jour (voir
# Server/Discord/DiscordAnnouncer.cs). Créez une application sur https://discord.com/developers,
# ajoutez-lui un Bot, copiez son token ici, puis invitez-le sur votre serveur Discord avec les
# permissions "Envoyer des messages" et "Intégrer des liens" sur le salon visé.
DISCORD_BOT_TOKEN=

# Optionnel : identifiants des salons Discord où poster les annonces, séparés par des virgules
# (ex. "123,456"). Si absent, les salons par défaut codés dans DiscordAnnouncer.cs sont utilisés.
# DISCORD_ANNOUNCE_CHANNEL_ID (singulier, un seul salon) reste accepté pour compatibilité.
DISCORD_ANNOUNCE_CHANNEL_IDS=

# Optionnel : identifiant du rôle Discord à notifier (ping) à chaque annonce. Si absent, une
# valeur par défaut codée dans DiscordAnnouncer.cs est utilisée.
DISCORD_ANNOUNCE_ROLE_ID=

# --- Link de compte Discord + rôles de grade automatiques (voir Server/Discord/) ---
# Le bot doit avoir la permission "Manage Roles" et son rôle doit être placé AU-DESSUS de tous
# les rôles de grade ci-dessous dans la hiérarchie du serveur Discord, sinon l'attribution échoue
# silencieusement (journalisée en warning côté serveur).
#
# Sur une instance dev ET une instance prod tournant sur la même machine (voir
# start-server-dev.bat/start-server-prod.bat) : utilisez deux applications Discord séparées (donc
# deux DISCORD_BOT_TOKEN différents, un par .env/instance) si vos serveurs Discord dev et prod
# sont distincts — une même connexion Gateway ne doit pas tourner deux fois avec le même token.

# Identifiant de l'application Discord (PAS le token du bot) — page "General Information" de
# votre application sur https://discord.com/developers/applications. Requis pour enregistrer la
# commande slash /link.
DISCORD_APPLICATION_ID=

# Identifiants des serveurs Discord (guildes) où la commande /link doit être active et où les
# rôles de grade sont attribués, séparés par des virgules (ex. "123,456"). Activez le mode
# développeur Discord (Paramètres > Avancés) pour "Copier l'identifiant" d'un serveur.
DISCORD_GUILD_IDS=

# Optionnel : un ou plusieurs rôles (séparés par des virgules, ex. "123,456") donnés dès qu'un
# compte est vérifié (lié), quel que soit son grade — jamais retirés ensuite.
DISCORD_VERIFIED_ROLE_ID=

# Un ou plusieurs identifiants de rôle Discord par grade (séparés par des virgules — voir
# Shared/Enums/UserRank.cs) — absent = ce grade n'est simplement jamais attribué/retiré
# automatiquement.
DISCORD_ROLE_ID_JOUEUR=
DISCORD_ROLE_ID_VIP=
DISCORD_ROLE_ID_TESTEUR=
DISCORD_ROLE_ID_AMI=
DISCORD_ROLE_ID_MODERATEUR=
DISCORD_ROLE_ID_FONDATEUR=

# --- Portail web (Aetheria.Web) — voir Docs/Deploiement-Web.md ---
# Ces variables se règlent sur l'hébergeur du site (Render), pas forcément dans ce .env local.
#
# Base de données PARTAGÉE entre le serveur de jeu et le portail web : mettre ici la MÊME valeur
# des deux côtés. Accepte une URL Neon (postgresql://…) ou une chaîne Npgsql clé-valeur.
# AETHERIA_DB_CONNECTION=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Le bot doit avoir la permission « Gérer les salons » dans la guilde ci-dessous.
DISCORD_BETA_GUILD_ID=
DISCORD_BETA_CATEGORY_ID=1531565847125164123
DISCORD_BETA_STAFF_ROLE_IDS=1531571205805707385,1516429803442671626
DISCORD_INVITE_URL=https://discord.gg/8NqXPsg7gE
# URL /api/health du serveur de jeu, pour le badge « serveur en ligne » du site (facultatif).
GAME_SERVER_HEALTH_URL=
# Amorce le compte admin si la base est vierge et qu'aucun compte IsAdmin n'existe (facultatif —
# le serveur de jeu crée déjà ce compte de son côté).
AETHERIA_ADMIN_BOOTSTRAP_PASSWORD=

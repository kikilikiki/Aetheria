# Copiez ce fichier en ".env" (à la racine du dépôt) et remplissez vos propres valeurs.
# ".env" est ignoré par git (voir .gitignore) : n'y mettez jamais ce fichier ".exemple" à jour
# avec de vraies valeurs, modifiez uniquement votre copie locale ".env".

# Jeton du bot Discord utilisé pour poster les annonces de mise à jour (voir
# Server/Discord/DiscordAnnouncer.cs). Créez une application sur https://discord.com/developers,
# ajoutez-lui un Bot, copiez son token ici, puis invitez-le sur votre serveur Discord avec les
# permissions "Envoyer des messages" et "Intégrer des liens" sur le salon visé.
DISCORD_BOT_TOKEN=

# Optionnel : identifiant du salon Discord où poster les annonces. Si absent, une valeur par
# défaut codée dans DiscordAnnouncer.cs est utilisée.
DISCORD_ANNOUNCE_CHANNEL_ID=

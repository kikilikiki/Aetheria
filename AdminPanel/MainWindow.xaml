<Window x:Class="Aetheria.AdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aetheria — AdminPanel" Height="640" Width="900"
        WindowStartupLocation="CenterScreen" Background="#101116">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Statistiques globales -->
        <Border Grid.Row="0" BorderBrush="#333" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Comptes : " Foreground="#A0A0B0" />
                <TextBlock Text="{Binding Stats.TotalUsers}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                <TextBlock Text="Bannis : " Foreground="#A0A0B0" />
                <TextBlock Text="{Binding Stats.BannedUsers}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                <TextBlock Text="Personnages : " Foreground="#A0A0B0" />
                <TextBlock Text="{Binding Stats.TotalCharacters}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                <TextBlock Text="Créatures capturées : " Foreground="#A0A0B0" />
                <TextBlock Text="{Binding Stats.TotalMonstersCaptured}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                <TextBlock Text="Guildes : " Foreground="#A0A0B0" />
                <TextBlock Text="{Binding Stats.TotalGuilds}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                <TextBlock Text="Saison active : " Foreground="#A0A0B0" />
                <TextBlock Text="{Binding Stats.ActiveSeasonNumber}" Foreground="#E8E8F0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Recherche et liste des comptes -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="6" Margin="0,0,6,0" />
                    <Button Content="Rechercher" Command="{Binding SearchCommand}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="Charger tout" Command="{Binding LoadCommand}" Padding="10,6" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pseudo" Binding="{Binding Username}" Width="140" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                        <DataGridTextColumn Header="Personnages" Binding="{Binding CharacterCount}" Width="90" />
                        <DataGridTextColumn Header="Banni" Binding="{Binding IsBanned}" Width="60" />
                        <DataGridTextColumn Header="Raison" Binding="{Binding BanReason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Actions sur le compte sélectionné -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Bannissement" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Raison" Foreground="#A0A0B0" Margin="0,0,0,4" />
                <TextBox Text="{Binding BanReason, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

                <Button Content="Bannir" Command="{Binding BanCommand}" Padding="16,8" Margin="0,0,0,8" />
                <Button Content="Débannir" Command="{Binding UnbanCommand}" Padding="16,8" />

                <TextBlock Text="{Binding StatusMessage}" Foreground="#F0A0A0" TextWrapping="Wrap" Margin="0,16,0,0" />
                <TextBlock Text="Chargement..." Foreground="#A0A0B0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

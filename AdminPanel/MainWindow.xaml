<Window x:Class="Aetheria.AdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aetheria.AdminPanel"
        Title="Aetheria — AdminPanel" Height="640" Width="900"
        WindowStartupLocation="CenterScreen" Background="#101116">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <!-- Écran de connexion admin : tant qu'aucun compte IsAdmin n'est authentifié, aucune
             action de gestion des comptes n'est possible (voir AdminAuthService côté serveur). -->
        <StackPanel x:Name="AdminLoginPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="Connexion administrateur" FontSize="18" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,0,0,16" HorizontalAlignment="Center" />
            <TextBlock Text="Pseudo ou email" Foreground="#A0A0B0" Margin="0,0,0,4" />
            <TextBox Text="{Binding AdminUsernameOrEmail, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10" />
            <TextBlock Text="Mot de passe" Foreground="#A0A0B0" Margin="0,0,0,4" />
            <PasswordBox x:Name="AdminPasswordBox" Padding="6" Margin="0,0,0,16" PasswordChanged="OnAdminPasswordChanged" />
            <Button Content="Se connecter" Command="{Binding AdminLoginCommand}" Padding="16,8" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#F0A0A0" TextWrapping="Wrap" Margin="0,16,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Statistiques globales -->
        <Border Grid.Row="0" BorderBrush="#333" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Comptes : " Foreground="#A0A0B0" />
                    <TextBlock Text="{Binding Stats.TotalUsers}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                    <TextBlock Text="Bannis : " Foreground="#A0A0B0" />
                    <TextBlock Text="{Binding Stats.BannedUsers}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                    <TextBlock Text="Personnages : " Foreground="#A0A0B0" />
                    <TextBlock Text="{Binding Stats.TotalCharacters}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                    <TextBlock Text="Créatures capturées : " Foreground="#A0A0B0" />
                    <TextBlock Text="{Binding Stats.TotalMonstersCaptured}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                    <TextBlock Text="Guildes : " Foreground="#A0A0B0" />
                    <TextBlock Text="{Binding Stats.TotalGuilds}" Foreground="#E8E8F0" Margin="0,0,16,0" />
                    <TextBlock Text="Saison active : " Foreground="#A0A0B0" />
                    <TextBlock Text="{Binding Stats.ActiveSeasonNumber}" Foreground="#E8E8F0" />
                </StackPanel>
                <Button Content="Déconnexion" Command="{Binding AdminLogoutCommand}" Padding="10,4" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Recherche et liste des comptes -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="6" Margin="0,0,6,0" />
                    <Button Content="Rechercher" Command="{Binding SearchCommand}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="Charger tout" Command="{Binding LoadCommand}" Padding="10,6" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pseudo" Binding="{Binding Username}" Width="140" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                        <DataGridTextColumn Header="Personnages" Binding="{Binding CharacterCount}" Width="90" />
                        <DataGridTextColumn Header="Banni" Binding="{Binding IsBanned}" Width="55" />
                        <DataGridTextColumn Header="Supprimé" Binding="{Binding IsDeleted}" Width="70" />
                        <DataGridTextColumn Header="Admin" Binding="{Binding IsAdmin}" Width="55" />
                        <DataGridTextColumn Header="Grade" Binding="{Binding Rank}" Width="90" />
                        <DataGridTextColumn Header="Muet" Binding="{Binding IsMuted}" Width="50" />
                        <DataGridTextColumn Header="Derniere IP" Binding="{Binding LastKnownIp}" Width="110" />
                        <DataGridTextColumn Header="Raison" Binding="{Binding BanReason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Actions sur le compte sélectionné -->
            <StackPanel Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Bannissement" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Raison" Foreground="#A0A0B0" Margin="0,0,0,4" />
                        <TextBox Text="{Binding BanReason, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" />

                        <Button Content="Bannir" Command="{Binding BanCommand}" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="Débannir" Command="{Binding UnbanCommand}" Padding="16,8" />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Modifier le compte" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Nouveau pseudo" Foreground="#A0A0B0" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8" />
                        <TextBlock Text="Nouvel email" Foreground="#A0A0B0" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10" />
                        <Button Content="Enregistrer" Command="{Binding ModifyUserCommand}" Padding="16,8" />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Compte" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                        <Button Content="Basculer permission admin" Command="{Binding ToggleAdminPermissionCommand}" Padding="16,8" Margin="0,0,0,8" />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Grade" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding AvailableRanks}" SelectedItem="{Binding SelectedRank}" Padding="6" Margin="0,0,0,8" />
                        <Button Content="Définir le grade" Command="{Binding SetRankCommand}" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="Supprimer le compte" Command="{Binding DeleteUserCommand}" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="Restaurer le compte" Command="{Binding RestoreUserCommand}" Padding="16,8" />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Text="Modération" Foreground="#A0A0B0" FontWeight="Bold" Margin="0,0,0,8" />
                        <Button Content="Basculer mute (tchat)" Command="{Binding ToggleMuteCommand}" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="Bannir la dernière IP" Command="{Binding BanIpCommand}" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="Réinitialiser le profil de jeu" Command="{Binding ResetProfileCommand}" Padding="16,8" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#F0A0A0" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="Chargement..." Foreground="#A0A0B0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>

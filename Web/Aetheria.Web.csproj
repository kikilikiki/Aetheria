<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Aetheria.Web : portail web public (site vitrine + connexion au compte + candidatures
       bêta-testeur + administration). Déployé séparément du serveur de jeu (voir
       Docs/Deploiement-Web.md) mais partage la même base de données via AETHERIA_DB_CONNECTION,
       donc les mêmes comptes / mots de passe / grades. N'a AUCUNE dépendance sur Aetheria.Server. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aetheria.Web</RootNamespace>
    <AssemblyName>Aetheria.Web</AssemblyName>
    <UserSecretsId>aetheria-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Aetheria.Shared.csproj" />
    <ProjectReference Include="..\Database\Aetheria.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Même hachage BCrypt que le serveur de jeu (voir Server/Persistence/PasswordHasher.cs) :
         un mot de passe créé d'un côté doit se vérifier de l'autre. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- Base fichier zéro-installation pour le développement local (AETHERIA_DB_CONNECTION absent) ;
         en production c'est PostgreSQL (Neon) via Npgsql, déjà fourni par Aetheria.Database. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
  </ItemGroup>

</Project>

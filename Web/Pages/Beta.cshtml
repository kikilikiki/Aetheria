@page "/beta"
@model BetaModel
@using Aetheria.Shared.Enums
@{
    ViewData["Title"] = "Candidature bêta";
}

<div class="container narrow">
    <h1 class="section-title" style="text-align:left;">Devenir bêta-testeur</h1>

    @if (Model.Submitted)
    {
        <div class="alert alert-ok">
            Candidature envoyée ! Le staff vérifie ta présence sur le Discord et t'ouvre un salon
            privé <strong>beta-test-…</strong> d'ici quelques minutes. Si ton pseudo Discord est
            introuvable, la candidature sera refusée automatiquement — tu verras la raison sur
            <a href="/mon-compte">ton compte</a>.
        </div>
        <a class="btn btn-secondary" href="/mon-compte">Voir le statut</a>
    }
    else if (Model.Existing is { Status: BetaApplicationStatus.Pending })
    {
        <div class="alert alert-info">Ta candidature est déjà en cours de traitement. Suis-la sur <a href="/mon-compte">ton compte</a> et dans ton salon Discord.</div>
        <a class="btn btn-secondary" href="/mon-compte">Voir le statut</a>
    }
    else if (Model.Existing is { Status: BetaApplicationStatus.Approved })
    {
        <div class="alert alert-ok">Tu es déjà accepté·e en bêta. Bienvenue !</div>
    }
    else
    {
        if (Model.Existing is { Status: BetaApplicationStatus.Rejected })
        {
            <div class="alert alert-info">
                Ta candidature précédente a été refusée@(string.IsNullOrWhiteSpace(Model.Existing.AdminNote) ? "." : $" : {Model.Existing.AdminNote}") Tu peux en soumettre une nouvelle.
            </div>
        }

        <p style="color:var(--text-dim);">
            La candidature crée un salon privé sur le
            <a href="@Aetheria.Shared.GameInfo.DiscordInviteUrl" target="_blank" rel="noopener">Discord</a>
            avec le staff. Tu dois donc avoir rejoint le serveur Discord avec le pseudo indiqué.
        </p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-error">@Model.Error</div>
        }

        <form method="post" class="form-panel">
            <div class="field">
                <label for="d">Pseudo Discord</label>
                @if (Model.DiscordLinked)
                {
                    <input id="d" value="Compte Discord lié ✔" disabled />
                    <div class="hint">Ton compte Discord est déjà lié, on l'utilise directement.</div>
                }
                else
                {
                    <input id="d" name="DiscordHandle" value="@Model.DiscordHandle" placeholder="ton_pseudo" required />
                    <div class="hint">Ton nom d'utilisateur Discord (pas un surnom de serveur).</div>
                }
            </div>
            <div class="field">
                <label for="e">Email de contact</label>
                <input id="e" name="ContactEmail" type="email" value="@Model.ContactEmail" required />
            </div>
            <div class="field">
                <label for="p">Pseudo en jeu</label>
                <input id="p" name="InGamePseudo" value="@Model.InGamePseudo" required />
            </div>
            <div class="field">
                <label for="pf">Plateforme</label>
                <select id="pf" name="Platform">
                    <option value="Windows" selected="@(Model.Platform != "Linux")">Windows</option>
                    <option value="Linux" selected="@(Model.Platform == "Linux")">Linux</option>
                </select>
            </div>
            <div class="field">
                <label for="hw">Configuration PC (processeur, carte graphique, RAM)</label>
                <textarea id="hw" name="HardwareSpecs" required>@Model.HardwareSpecs</textarea>
            </div>
            <div class="field">
                <label for="mot">Pourquoi souhaites-tu devenir bêta-testeur ?</label>
                <textarea id="mot" name="Motivation" required>@Model.Motivation</textarea>
            </div>
            <div class="field">
                <label for="disc">Comment as-tu découvert notre communauté ?</label>
                <textarea id="disc" name="Discovery" required>@Model.Discovery</textarea>
            </div>
            <div class="field">
                <label for="bug">Es-tu à l'aise pour écrire un rapport de bug détaillé ?</label>
                <select id="bug" name="BugReportComfort" required>
                    <option value="" disabled selected="@(string.IsNullOrEmpty(Model.BugReportComfort))">— choisir —</option>
                    <option value="Oui" selected="@(Model.BugReportComfort == "Oui")">Oui, sans problème</option>
                    <option value="Avec un modèle" selected="@(Model.BugReportComfort == "Avec un modèle")">Oui, avec un modèle à suivre</option>
                    <option value="Pas trop" selected="@(Model.BugReportComfort == "Pas trop")">Pas vraiment</option>
                </select>
            </div>
            <div class="field">
                <label for="cc">Créateur de contenu ? (YouTube / Twitch / TikTok + lien — facultatif)</label>
                <input id="cc" name="ContentCreator" value="@Model.ContentCreator" maxlength="300" placeholder="https://…" />
            </div>
            <div class="field">
                <label for="refc">Code de parrainage (facultatif)</label>
                <input id="refc" name="ref" value="@Model.ReferralCode" placeholder="ex. AB12CD" maxlength="16" />
                <div class="hint">Si un testeur t'a partagé son lien, le code est déjà rempli.</div>
            </div>
            <div class="field">
                <label for="n">Autre / remarques (facultatif)</label>
                <textarea id="n" name="Notes">@Model.Notes</textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Envoyer ma candidature</button>
        </form>
    }
</div>

@page "/admin/candidatures"
@model Aetheria.Web.Pages.Admin.CandidaturesModel
@using Aetheria.Shared.Enums
@{
    ViewData["Title"] = "Candidatures bêta";
}

<div class="container">
    <h1 class="section-title" style="text-align:left;">Candidatures bêta</h1>

    @if (!string.IsNullOrEmpty(Model.Flash))
    {
        <div class="alert alert-ok">@Model.Flash</div>
    }

    <p class="hint" style="text-transform:none;">
        La vérification Discord et la création du salon sont faites par le serveur de jeu (quelques
        secondes après la soumission). Valider / refuser ici met à jour le statut ; le serveur de
        jeu poste la décision dans le salon et attribue le rôle « Testeur ».
    </p>

    <p>
        Filtre :
        <a href="?filter=pending">En attente</a> ·
        <a href="?filter=approved">Acceptées</a> ·
        <a href="?filter=rejected">Refusées</a> ·
        <a href="?filter=all">Toutes</a>
    </p>

    @if (Model.Applications.Count == 0)
    {
        <p style="color:var(--text-dim);">Aucune candidature.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Date</th><th>Compte</th><th>Discord</th><th>Plateforme</th>
                        <th>Config PC</th><th>Réponses</th><th>Parrainage</th><th>Traitement</th><th>Statut</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in Model.Applications)
                {
                    var cls = a.Status == BetaApplicationStatus.Approved ? "approved"
                        : a.Status == BetaApplicationStatus.Rejected ? "rejected" : "pending";
                    <tr>
                        <td>@a.CreatedAtUtc.ToString("dd/MM/yy HH:mm")</td>
                        <td>@a.Username<br /><span style="color:var(--text-dim);font-size:.8rem;">@a.ContactEmail</span></td>
                        <td>
                            @a.DiscordHandle
                            @if (!string.IsNullOrEmpty(a.DiscordTicketChannelId) && !string.IsNullOrEmpty(Model.DiscordGuildId))
                            {
                                <br /><a href="https://discord.com/channels/@Model.DiscordGuildId/@a.DiscordTicketChannelId" target="_blank" rel="noopener" style="font-size:.8rem;">salon</a>
                            }
                        </td>
                        <td>@a.Platform</td>
                        <td style="max-width:200px;white-space:pre-wrap;">@a.HardwareSpecs</td>
                        <td style="max-width:280px;">
                            <strong>Motivation :</strong> <span style="white-space:pre-wrap;">@a.Motivation</span><br />
                            <strong>Découverte :</strong> <span style="white-space:pre-wrap;">@a.Discovery</span>
                            @if (!string.IsNullOrWhiteSpace(a.Notes))
                            {
                                <br /><strong>Remarques :</strong> <span style="white-space:pre-wrap;">@a.Notes</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(a.ReferralCodeUsed) ? "—" : a.ReferralCodeUsed)</td>
                        <td>
                            @if (a.ProcessedAtUtc is null)
                            {
                                <span style="color:var(--warn);">en attente</span>
                            }
                            else if (!string.IsNullOrEmpty(a.DiscordTicketChannelId))
                            {
                                <span style="color:var(--ok);">salon créé</span>
                            }
                            else
                            {
                                <span style="color:var(--text-dim);">traitée, sans salon</span>
                            }
                        </td>
                        <td>
                            <span class="badge @cls">@a.Status</span>
                            @if (!string.IsNullOrWhiteSpace(a.ReviewedByUsername))
                            {
                                <br /><span style="color:var(--text-dim);font-size:.75rem;">@a.ReviewedByUsername</span>
                            }
                            @if (a.Status == BetaApplicationStatus.Rejected && !string.IsNullOrWhiteSpace(a.AdminNote))
                            {
                                <br /><span style="color:var(--text-dim);font-size:.75rem;">@a.AdminNote</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                @if (a.Status != BetaApplicationStatus.Approved)
                                {
                                    <form method="post" asp-page-handler="Approve" asp-route-id="@a.Id" asp-route-filter="@Model.Filter">
                                        <label style="font-size:.75rem;color:var(--text-dim);"><input type="checkbox" name="grantTester" value="true" checked /> grade Testeur</label>
                                        <button type="submit" class="btn btn-secondary" style="padding:6px 12px;">Valider</button>
                                    </form>
                                }
                                @if (a.Status != BetaApplicationStatus.Rejected)
                                {
                                    <form method="post" asp-page-handler="Reject" asp-route-id="@a.Id" asp-route-filter="@Model.Filter">
                                        <input type="text" name="note" class="mini-input" placeholder="raison (option.)" />
                                        <button type="submit" class="btn btn-secondary" style="padding:6px 12px;">Refuser</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@page "/admin"
@model Aetheria.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administration";
}

<div class="container">
    <h1 class="section-title" style="text-align:left;">Administration</h1>

    <div class="grid">
        <div class="card"><h3>@Model.Pending</h3><p>Candidatures en attente</p></div>
        <div class="card"><h3>@Model.Approved</h3><p>Acceptées</p></div>
        <div class="card"><h3>@Model.Rejected</h3><p>Refusées</p></div>
        <div class="card"><h3>@Model.Accounts</h3><p>Comptes</p></div>
    </div>

    <p style="margin-top:24px;"><a class="btn btn-primary" href="/admin/candidatures">Traiter les candidatures</a></p>

    <div class="form-panel" style="margin-top:24px;">
        <h3 style="margin-top:0;">Intégration Discord</h3>
        <p class="hint" style="text-transform:none;">
            Les salons de ticket sont créés par le <strong>serveur de jeu</strong> (pas par ce site —
            l'IP de l'hébergeur est rate-limitée par Discord). Il doit tourner avec
            <code>DISCORD_BOT_TOKEN</code> + <code>DISCORD_GUILD_IDS</code>, le bot ayant la permission
            « Gérer les salons » et l'intent « Server Members ».
        </p>
        @if (Model.AwaitingProcessing > 0)
        {
            <p style="color:var(--warn);">@Model.AwaitingProcessing candidature(s) en attente de traitement par le serveur de jeu.</p>
        }
        else
        {
            <p style="color:var(--ok);">Aucune candidature en attente de traitement.</p>
        }
    </div>
</div>

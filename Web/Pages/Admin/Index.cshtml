@page "/admin"
@model Aetheria.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administration";
}

<div class="container">
    <h1 class="section-title" style="text-align:left;">Administration</h1>

    <div class="grid">
        <div class="card"><h3>@Model.Pending</h3><p>Candidatures en attente</p></div>
        <div class="card"><h3>@Model.Approved</h3><p>Acceptées</p></div>
        <div class="card"><h3>@Model.Rejected</h3><p>Refusées</p></div>
        <div class="card"><h3>@Model.Accounts</h3><p>Comptes</p></div>
    </div>

    <p style="margin-top:24px;"><a class="btn btn-primary" href="/admin/candidatures">Traiter les candidatures</a></p>

    <div class="form-panel" style="margin-top:24px;">
        <h3 style="margin-top:0;">Intégration Discord</h3>
        @if (Model.DiscordConfigured)
        {
            <p style="color:var(--ok);">Configurée — serveur <code>@Model.DiscordGuildId</code>.</p>
            <p class="hint" style="text-transform:none;">
                Si la vérification échoue : le bot doit être sur ce serveur, avoir la permission
                « Gérer les salons », et l'intent privilégié « SERVER MEMBERS INTENT » doit être
                activé dans le portail développeur Discord. Les erreurs détaillées sont dans les
                logs Render.
            </p>
        }
        else
        {
            <p style="color:var(--err);">Non configurée — définis <code>DISCORD_BOT_TOKEN</code> et <code>DISCORD_BETA_GUILD_ID</code> sur Render.</p>
        }
    </div>
</div>

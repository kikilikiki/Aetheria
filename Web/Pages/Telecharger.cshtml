@page
@{
    ViewData["Title"] = "Télécharger";
    var canDownload = User.HasClaim("can_download", "true");
    var isAuth = User.Identity?.IsAuthenticated == true;
}

<div class="container narrow" style="text-align:center;">
    <h1 class="section-title">Télécharger Aetheria</h1>
    <p class="section-lead">
        Le Launcher installe le jeu, gère les mises à jour et vous connecte à votre compte.
    </p>

    @if (!canDownload)
    {
        <div class="alert alert-info" style="text-align:left;">
            Aetheria est en <strong>bêta fermée</strong>. Le téléchargement est réservé aux
            bêta-testeurs acceptés (grade Testeur).
        </div>
        @if (isAuth)
        {
            <a class="btn btn-primary" href="/beta">Postuler pour la bêta</a>
            <a class="btn btn-secondary" href="/mon-compte">Voir ma candidature</a>
        }
        else
        {
            <a class="btn btn-primary" href="/connexion">Se connecter</a>
            <a class="btn btn-secondary" href="/inscription">Créer un compte</a>
        }
    }
    else
    {
        <div class="os-tabs" role="tablist">
            <button class="os-tab" data-os="windows" type="button" onclick="selectOs('windows')">Windows</button>
            <button class="os-tab" data-os="linux" type="button" onclick="selectOs('linux')">Linux</button>
        </div>

        <div id="os-panel-windows" class="os-panel">
            <a class="btn btn-primary" href="/telechargement?os=windows">Installer le Launcher (.exe)</a>
            <p class="section-lead" style="margin-top:16px;">
                Un seul exécutable : lancez-le pour installer le Launcher, puis lancez le Launcher
                pour jouer. Nécessite le
                <a href="https://dotnet.microsoft.com/download/dotnet/10.0" target="_blank" rel="noopener">runtime .NET 10 Desktop</a>.
            </p>
        </div>

        <div id="os-panel-linux" class="os-panel">
            <a class="btn btn-primary" href="/telechargement?os=deb">Installer le Launcher (.deb)</a>
            <a class="btn btn-secondary" href="/telechargement?os=tar">Archive .tar.gz</a>
            <p class="section-lead" style="margin-top:16px;">
                Le paquet installe le Launcher et le client : lancez <code>aetheria</code> pour
                jouer, comme sous Windows.
            </p>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

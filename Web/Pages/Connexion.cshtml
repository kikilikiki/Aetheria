@page "/connexion"
@model ConnexionModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="container narrow">
    <h1 class="section-title" style="text-align:left;">Connexion</h1>
    <p style="color:var(--text-dim);">Utilise le même compte que dans le jeu.</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }

    <form method="post" class="form-panel">
        <div class="field">
            <label for="id">Pseudo ou email</label>
            <input id="id" name="UsernameOrEmail" value="@Model.UsernameOrEmail" autocomplete="username" required />
        </div>
        <div class="field">
            <label for="pw">Mot de passe</label>
            <input id="pw" name="Password" type="password" autocomplete="current-password" required />
        </div>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
    </form>

    <p style="margin-top:16px;color:var(--text-dim);">
        Pas encore de compte ? <a href="/inscription">Créer un compte</a>
    </p>
</div>
